#!/sbin/sh
# TWRP installer. Formats nothing: format data in TWRP first.
OUTFD=/proc/self/fd/$2
ZIP=$3
say() { echo "ui_print $1" > "$OUTFD"; echo "ui_print" > "$OUTFD"; }
die() { say "ERROR: $1"; exit 1; }

D=$(getprop ro.product.device)
case "$D" in gts7xlwifi|gts7xl) ;; *) die "this is for the Tab S7+ Wi-Fi, found: $D" ;; esac

BOOT=/dev/block/by-name/boot; DTBO=/dev/block/by-name/dtbo; PARAM=/dev/block/by-name/param
for p in "$BOOT" "$DTBO" "$PARAM"; do [ -e "$p" ] || die "missing $p"; done

mount /data 2>/dev/null
grep -q ' /data ' /proc/mounts || die "/data is not mounted. Format data first"
[ -e /data/media/0 ] && die "/data still holds Android data. Use Wipe, Format Data, then reboot to recovery"
FREE=$(df -k /data | awk 'NR==2 {print $4}')
[ "$FREE" -gt 12000000 ] || die "need 12 GB free on /data"

say "Installing Arch Linux, this takes a few minutes"
unzip -p "$ZIP" rootfs.tar.gz | tar -xzf - -C /data || die "could not unpack the system"
sync

say "Writing boot image"
unzip -p "$ZIP" boot.img > /tmp/boot.img || die "could not unpack boot.img"
dd if=/dev/zero of="$BOOT" bs=1048576 2>/dev/null
dd if=/tmp/boot.img of="$BOOT" bs=4096 2>/dev/null || die "could not write boot"
dd if=/dev/zero of="$DTBO" bs=4096 count=1 conv=notrunc 2>/dev/null || die "could not blank dtbo"
printf '\0' | dd of="$PARAM" bs=1 count=1 conv=notrunc 2>/dev/null
sync
say "Done. Reboot to system. First boot copies firmware from your tablet"
exit 0
