[Unit]
Description=Early kernel log on userdata
# On the root filesystem, not /var/log: it starts before the other mounts, and on
# btrfs /var/log is its own subvolume that would hide it
DefaultDependencies=no
After=local-fs-pre.target
Before=gts7xl-hw.service
[Service]
ExecStart=/bin/sh -c 'mkdir -p /var/lib/gts7xl/early; cd /var/lib/gts7xl/early; ls -t | tail -n +11 | xargs -r rm -f; f=$(date +%%s)-$$.log; dmesg -w >> "$f" & while :; do sleep 2; sync "$f"; done'
Restart=no
[Install]
WantedBy=sysinit.target
