From f27d7eb2ae1e61ad348e02ff63d2a5d8ef0efd6f Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 2 Nov 2026 21:10:51 +0100
Subject: [PATCH] gts7xlwifi: fix cameras randomly not answering

Keep the shared VIO rail on, give the analog rails time to discharge and wait
longer after reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts | 5 +++++
 drivers/media/i2c/s5k-tab.c                            | 3 ++-
 drivers/media/i2c/s5k3m5.c                             | 3 ++-
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index e381795d5..48dd4d4b2 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -105,6 +105,7 @@ cam_rear_vana: cam-rear-vana-regulator {
 		regulator-min-microvolt = <2800000>;
 		regulator-max-microvolt = <2800000>;
 		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
 		enable-active-high;
 	};
 
@@ -115,6 +116,8 @@ cam_vio: cam-vio-regulator {
 		regulator-max-microvolt = <1800000>;
 		gpio = <&tlmm 37 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
+		/* Shared by all three cameras: cycling it leaves them not answering */
+		regulator-always-on;
 	};
 
 	cam_front_vana: cam-front-vana-regulator {
@@ -123,6 +126,7 @@ cam_front_vana: cam-front-vana-regulator {
 		regulator-min-microvolt = <2800000>;
 		regulator-max-microvolt = <2800000>;
 		gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
 		enable-active-high;
 	};
 
@@ -132,6 +136,7 @@ cam_wide_vana: cam-wide-vana-regulator {
 		regulator-min-microvolt = <2800000>;
 		regulator-max-microvolt = <2800000>;
 		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <50000>;
 		enable-active-high;
 	};
 
diff --git a/drivers/media/i2c/s5k-tab.c b/drivers/media/i2c/s5k-tab.c
index ed1f62a3d..67d8d1895 100644
--- a/drivers/media/i2c/s5k-tab.c
+++ b/drivers/media/i2c/s5k-tab.c
@@ -478,8 +478,9 @@ static int s5ktab_power_on(struct device *dev)
 		regulator_bulk_disable(ARRAY_SIZE(s->supplies), s->supplies);
 		return ret;
 	}
+	usleep_range(2000, 3000);
 	gpiod_set_value_cansleep(s->reset, 0);
-	usleep_range(10000, 15000);
+	usleep_range(20000, 25000);
 	return 0;
 }
 
diff --git a/drivers/media/i2c/s5k3m5.c b/drivers/media/i2c/s5k3m5.c
index 36ee4df47..203d7a3c5 100644
--- a/drivers/media/i2c/s5k3m5.c
+++ b/drivers/media/i2c/s5k3m5.c
@@ -1095,8 +1095,9 @@ static int s5k3m5_power_on(struct device *dev)
 	if (ret)
 		goto disable_regulators;
 
+	usleep_range(2 * USEC_PER_MSEC, 3 * USEC_PER_MSEC);
 	gpiod_set_value_cansleep(s5k3m5->reset_gpio, 0);
-	usleep_range(10 * USEC_PER_MSEC, 15 * USEC_PER_MSEC);
+	usleep_range(20 * USEC_PER_MSEC, 25 * USEC_PER_MSEC);
 
 	return 0;
 
-- 
2.56.0

