From 81e3f9f22990d401a9483ffef0e0301770279609 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 2 Nov 2026 21:04:22 +0100
Subject: [PATCH] gts7xlwifi: add the front and ultrawide cameras

S5K4HA on CCI0 bus 1 and S5K5E9 on CCI1 bus 0, with a small driver using the
register settings of the stock sensor modules. gpio42 powers the ultrawide, so
it is no longer reserved.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8250-samsung-gts7xlwifi.dts    | 144 +++-
 drivers/media/i2c/Kconfig                     |   6 +
 drivers/media/i2c/Makefile                    |   1 +
 drivers/media/i2c/s5k-tab.c                   | 615 ++++++++++++++++++
 4 files changed, 765 insertions(+), 1 deletion(-)
 create mode 100644 drivers/media/i2c/s5k-tab.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 18ca12187..e381795d5 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -117,6 +117,24 @@ cam_vio: cam-vio-regulator {
 		enable-active-high;
 	};
 
+	cam_front_vana: cam-front-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_front_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	cam_wide_vana: cam-wide-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	vibrator {
 		compatible = "regulator-haptic";
 		haptic-supply = <&vreg_l7c_2p856>;
@@ -362,6 +380,24 @@ &camss {
 	status = "okay";
 
 	ports {
+		port@2 {
+			csiphy2_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_wide_ep>;
+			};
+		};
+
+		port@3 {
+			csiphy3_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+
 		port@0 {
 			csiphy0_ep: endpoint {
 				clock-lanes = <7>;
@@ -382,6 +418,36 @@ &cci1 {
 	status = "okay";
 };
 
+&cci1_i2c0 {
+	/* Rear 5MP ultrawide */
+	camera@10 {
+		compatible = "samsung,s5k5e9";
+		reg = <0x10>;
+
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;
+		vana-supply = <&cam_wide_vana>;
+		vio-supply = <&cam_vio>;
+
+		pinctrl-0 = <&cam_wide_default>;
+		pinctrl-names = "default";
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			cam_wide_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <897600000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
 &cci1_i2c1 {
 	/* Rear camera focus motor, a dw9808 */
 	cam_rear_focus: lens@c {
@@ -391,6 +457,36 @@ cam_rear_focus: lens@c {
 	};
 };
 
+&cci0_i2c1 {
+	/* Front 8MP */
+	camera@2d {
+		compatible = "samsung,s5k4ha";
+		reg = <0x2d>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		vana-supply = <&cam_front_vana>;
+		vio-supply = <&cam_vio>;
+
+		pinctrl-0 = <&cam_front_default>;
+		pinctrl-names = "default";
+
+		orientation = <0>;
+		rotation = <270>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <792000000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+};
+
 &cci0_i2c0 {
 	/* Rear 13MP. Stock only switches VANA and VIO, the digital rail hangs off VANA */
 	camera@2d {
@@ -933,7 +1029,7 @@ keyboard@2a {
 
 &tlmm {
 	/* gpio43 is the pogo connection detect line on this board */
-	gpio-reserved-ranges = <20 4>, <40 3>;
+	gpio-reserved-ranges = <20 4>, <40 2>;
 
 	panel_default: panel-default-state {
 		te-pins {
@@ -1016,6 +1112,52 @@ dout-pins {
 		};
 	};
 
+	cam_front_default: cam-front-default-state {
+		mclk-pins {
+			pins = "gpio96";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rst-pins {
+			pins = "gpio30";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		pwr-pins {
+			pins = "gpio38";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	cam_wide_default: cam-wide-default-state {
+		mclk-pins {
+			pins = "gpio95";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rst-pins {
+			pins = "gpio78";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
