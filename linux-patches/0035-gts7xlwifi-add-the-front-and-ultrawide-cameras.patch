+struct s5ktab_data {
+	const char *name;
+	u16 chip_id;
+	u32 width, height, hts, vts;
+	u32 lanes;
+	s64 link_freq;
+	const struct cci_reg_sequence *init, *mode;
+	unsigned int num_init, num_mode;
+};
+
+static const struct s5ktab_data s5k4ha_data = {
+	.name = "s5k4ha", .chip_id = 0x48ab,
+	.width = 3264, .height = 2448, .hts = 3688, .vts = 2516,
+	.lanes = 4, .link_freq = 792000000,
+	.init = s5k4ha_init, .num_init = ARRAY_SIZE(s5k4ha_init),
+	.mode = s5k4ha_mode, .num_mode = ARRAY_SIZE(s5k4ha_mode),
+};
+
+static const struct s5ktab_data s5k5e9_data = {
+	.name = "s5k5e9", .chip_id = 0x559b,
+	.width = 2576, .height = 1932, .hts = 3112, .vts = 2030,
+	.lanes = 2, .link_freq = 897600000,
+	.init = s5k5e9_init, .num_init = ARRAY_SIZE(s5k5e9_init),
+	.mode = s5k5e9_mode, .num_mode = ARRAY_SIZE(s5k5e9_mode),
+};
+
+struct s5ktab {
+	struct device *dev;
+	const struct s5ktab_data *data;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5ktab_supply_names)];
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	s64 link_freq[1];
+};
+
+static inline struct s5ktab *to_s5ktab(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5ktab, sd);
+}
+
+static int s5ktab_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5ktab *s = container_of(ctrl->handler, struct s5ktab, ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(s->exposure, s->exposure->minimum,
+					 s->data->height + ctrl->val - S5KTAB_EXPOSURE_MARGIN,
+					 1, s->exposure->default_value);
+
+	if (!pm_runtime_get_if_in_use(s->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s->regmap, S5KTAB_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s->regmap, S5KTAB_REG_AGAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s->regmap, S5KTAB_REG_VTS, s->data->height + ctrl->val, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+	}
+
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5ktab_ctrl_ops = {
+	.s_ctrl = s5ktab_set_ctrl,
+};
+
+static int s5ktab_init_controls(struct s5ktab *s)
+{
+	const struct s5ktab_data *d = s->data;
+	struct v4l2_ctrl_handler *h = &s->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *c;
+	s64 rate = div_u64(d->link_freq * 2 * d->lanes, 10);
+	int ret;
+
+	v4l2_ctrl_handler_init(h, 8);
+	s->link_freq[0] = d->link_freq;
+	c = v4l2_ctrl_new_int_menu(h, &s5ktab_ctrl_ops, V4L2_CID_LINK_FREQ, 0, 0, s->link_freq);
+	if (c)
+		c->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(h, &s5ktab_ctrl_ops, V4L2_CID_PIXEL_RATE, rate, rate, 1, rate);
+	c = v4l2_ctrl_new_std(h, &s5ktab_ctrl_ops, V4L2_CID_HBLANK, d->hts - d->width,
+			      d->hts - d->width, 1, d->hts - d->width);
+	if (c)
+		c->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(h, &s5ktab_ctrl_ops, V4L2_CID_VBLANK, d->vts - d->height,
+			  S5KTAB_VTS_MAX - d->height, 1, d->vts - d->height);
+	v4l2_ctrl_new_std(h, &s5ktab_ctrl_ops, V4L2_CID_ANALOGUE_GAIN, S5KTAB_AGAIN_MIN,
+			  S5KTAB_AGAIN_MAX, 1, S5KTAB_AGAIN_MIN);
+	s->exposure = v4l2_ctrl_new_std(h, &s5ktab_ctrl_ops, V4L2_CID_EXPOSURE, 2,
+					d->vts - S5KTAB_EXPOSURE_MARGIN, 1, d->vts / 4);
+
+	ret = v4l2_fwnode_device_parse(s->dev, &props);
+	if (!ret)
+		ret = v4l2_ctrl_new_fwnode_properties(h, &s5ktab_ctrl_ops, &props);
+	if (!ret)
+		ret = h->error;
+	if (ret) {
+		v4l2_ctrl_handler_free(h);
+		return ret;
+	}
+
+	s->sd.ctrl_handler = h;
+	return 0;
+}
+
+static int s5ktab_enable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 u32 pad, u64 streams_mask)
+{
+	struct s5ktab *s = to_s5ktab(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s->dev);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	cci_multi_reg_write(s->regmap, s->data->init, s->data->num_init, &ret);
+	cci_multi_reg_write(s->regmap, s->data->mode, s->data->num_mode, &ret);
+	if (!ret)
+		ret = __v4l2_ctrl_handler_setup(&s->ctrls);
+	cci_write(s->regmap, S5KTAB_REG_MODE, 1, &ret);
+	if (ret) {
+		dev_err(s->dev, "failed to start streaming: %d\n", ret);
+		pm_runtime_put(s->dev);
+	}
+	return ret;
+}
+
+static int s5ktab_disable_streams(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  u32 pad, u64 streams_mask)
+{
+	struct s5ktab *s = to_s5ktab(sd);
+	int ret = cci_write(s->regmap, S5KTAB_REG_MODE, 0, NULL);
+
+	pm_runtime_put(s->dev);
+	return ret;
+}
+
+static void s5ktab_fill_format(struct s5ktab *s, struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->width = s->data->width;
+	fmt->height = s->data->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5ktab_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	s5ktab_fill_format(to_s5ktab(sd), &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int s5ktab_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	return 0;
+}
+
+static int s5ktab_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5ktab *s = to_s5ktab(sd);
+
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+	fse->min_width = fse->max_width = s->data->width;
+	fse->min_height = fse->max_height = s->data->height;
+	return 0;
+}
+
+static int s5ktab_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5ktab *s = to_s5ktab(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = s->data->width;
+		sel->r.height = s->data->height;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int s5ktab_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	s5ktab_fill_format(to_s5ktab(sd), v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5ktab_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5ktab_pad_ops = {
+	.set_fmt = s5ktab_set_fmt,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5ktab_get_selection,
+	.enum_mbus_code = s5ktab_enum_mbus_code,
+	.enum_frame_size = s5ktab_enum_frame_size,
+	.enable_streams = s5ktab_enable_streams,
+	.disable_streams = s5ktab_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5ktab_subdev_ops = {
+	.video = &s5ktab_video_ops,
+	.pad = &s5ktab_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5ktab_internal_ops = {
+	.init_state = s5ktab_init_state,
+};
+
+static const struct media_entity_operations s5ktab_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5ktab_power_on(struct device *dev)
+{
+	struct s5ktab *s = to_s5ktab(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s->supplies), s->supplies);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(s->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(s->supplies), s->supplies);
+		return ret;
+	}
+	gpiod_set_value_cansleep(s->reset, 0);
+	usleep_range(10000, 15000);
+	return 0;
+}
+
+static int s5ktab_power_off(struct device *dev)
+{
+	struct s5ktab *s = to_s5ktab(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(s->reset, 1);
+	clk_disable_unprepare(s->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(s->supplies), s->supplies);
+	return 0;
+}
+
+static int s5ktab_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5ktab *s;
+	unsigned int i;
+	u64 id = 0;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	s->data = of_device_get_match_data(dev);
+	v4l2_i2c_subdev_init(&s->sd, client, &s5ktab_subdev_ops);
+
+	s->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s->regmap))
+		return PTR_ERR(s->regmap);
+	s->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(s->mclk))
+		return dev_err_probe(dev, PTR_ERR(s->mclk), "no clock\n");
+	if (clk_get_rate(s->mclk) != S5KTAB_MCLK)
+		return dev_err_probe(dev, -EINVAL, "clock must be 19.2MHz\n");
+	s->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(dev, PTR_ERR(s->reset), "no reset gpio\n");
+	for (i = 0; i < ARRAY_SIZE(s->supplies); i++)
+		s->supplies[i].supply = s5ktab_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s->supplies), s->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "no supplies\n");
+
+	ret = s5ktab_power_on(dev);
+	if (ret)
+		return ret;
+	ret = cci_read(s->regmap, S5KTAB_REG_CHIP_ID, &id, NULL);
+	dev_info(dev, "%s chip id %llx, expected %x, read %d\n", s->data->name, id,
+		 s->data->chip_id, ret);
+	if (ret) {
+		dev_err_probe(dev, ret, "sensor does not answer\n");
+		goto power_off;
+	}
+
+	ret = s5ktab_init_controls(s);
+	if (ret)
+		goto power_off;
+
+	s->sd.state_lock = s->ctrls.lock;
+	s->sd.internal_ops = &s5ktab_internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.ops = &s5ktab_entity_ops;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		goto free_ctrls;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (ret)
+		goto cleanup_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	ret = v4l2_async_register_subdev_sensor(&s->sd);
+	if (ret)
+		goto cleanup_subdev;
+	pm_runtime_idle(dev);
+	return 0;
+
+cleanup_subdev:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&s->sd);
+cleanup_entity:
+	media_entity_cleanup(&s->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+power_off:
+	s5ktab_power_off(dev);
+	return ret;
+}
+
+static void s5ktab_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5ktab *s = to_s5ktab(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+	pm_runtime_disable(s->dev);
+	if (!pm_runtime_status_suspended(s->dev))
+		s5ktab_power_off(s->dev);
+	pm_runtime_set_suspended(s->dev);
+}
+
+static const struct dev_pm_ops s5ktab_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5ktab_power_off, s5ktab_power_on, NULL)
+};
+
+static const struct of_device_id s5ktab_of_match[] = {
+	{ .compatible = "samsung,s5k4ha", .data = &s5k4ha_data },
+	{ .compatible = "samsung,s5k5e9", .data = &s5k5e9_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5ktab_of_match);
+
+static struct i2c_driver s5ktab_driver = {
+	.driver = {
+		.name = "s5k-tab",
+		.pm = &s5ktab_pm_ops,
+		.of_match_table = s5ktab_of_match,
+	},
+	.probe = s5ktab_probe,
+	.remove = s5ktab_remove,
+};
+module_i2c_driver(s5ktab_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4HA and S5K5E9 image sensor driver");
+MODULE_LICENSE("GPL");
