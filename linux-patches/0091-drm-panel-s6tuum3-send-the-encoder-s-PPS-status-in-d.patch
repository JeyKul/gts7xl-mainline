From e00244404386c25e6c723ba0848e87d8b96fa81b Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 16 Nov 2026 21:54:47 +0100
Subject: [PATCH 91/91] drm/panel: s6tuum3: send the encoder's PPS; status in
 debugfs

The panel got stock's fixed PPS bytes while the DPU compresses with the
parameters the host computes: rate control range 14 differed (min QP 13
vs 12). Pack the PPS from the DSC config in use and send it the stock way
(DCS 9Eh, 88 bytes, PPS id 1). Also set the frame memory window to the
whole panel, as stock's host does, and add debugfs s6tuum3_status with the
panel's power mode, error flags and DSI error count.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-samsung-s6tuum3.c | 54 ++++++++++++++++++-
 1 file changed, 53 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c b/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
index 20e3dbdf9..1d99a8839 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
@@ -6,6 +6,8 @@
 
 #include <linux/backlight.h>
 #include <linux/delay.h>
+#include <linux/seq_file.h>
+#include <linux/debugfs.h>
 #include <linux/dma-mapping.h>
 #include <linux/gpio/consumer.h>
 #include <linux/io.h>
@@ -166,7 +168,24 @@ static int s6tuum3_prepare(struct drm_panel *panel)
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x3e);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x78, 0x3c);
 	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
-	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, s6tuum3_pps, sizeof(s6tuum3_pps));
+	/*
+	 * The PPS the encoder actually uses (filled in by the host), not stock's
+	 * fixed bytes: those differ in rate control range 14 (min QP 12 vs 13)
+	 */
+	{
+		struct drm_dsc_picture_parameter_set pps;
+		u8 buf[sizeof(s6tuum3_pps)];
+
+		/* Stock's route: DCS 9Eh with the first 88 PPS bytes, ID 1 */
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		buf[0] = 0x9e;
+		memcpy(buf + 1, &pps, sizeof(buf) - 1);
+		buf[2] = s6tuum3_pps[2];
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, buf, sizeof(buf));
+	}
+	/* Frame memory window: the whole panel (stock's host sets it per frame) */
+	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0, 2800 - 1);
+	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0, 1752 - 1);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9a, 0x00);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x55, 0x02);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0f);
@@ -359,6 +378,38 @@ static const struct backlight_properties s6tuum3_bl_props = {
 	.max_brightness = S6TUUM3_MAX_BRIGHTNESS,
 };
 
+/*
+ * Panel status for debugging (debugfs s6tuum3_status): power mode (0Ah),
+ * signal/error flags (0Eh) and the DSI error count (05h), the registers
+ * stock reads as rddpm, errfg and dsierr. Read while the panel is on.
+ */
+static int s6tuum3_status_show(struct seq_file *m, void *unused)
+{
+	struct s6tuum3 *ctx = m->private;
+	static const struct { u8 reg; const char *name; } regs[] = {
+		{ 0x0a, "power mode (0Ah)" },
+		{ 0x0e, "signal mode / errfg (0Eh)" },
+		{ 0x05, "DSI error count (05h)" },
+	};
+	int i;
+
+	if (!ctx->enabled) {
+		seq_puts(m, "panel off\n");
+		return 0;
+	}
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		u8 v = 0;
+		int ret = mipi_dsi_dcs_read(ctx->dsi, regs[i].reg, &v, 1);
+
+		if (ret < 0)
+			seq_printf(m, "%-28s read failed %d\n", regs[i].name, ret);
+		else
+			seq_printf(m, "%-28s 0x%02x\n", regs[i].name, v);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(s6tuum3_status);
+
 static int s6tuum3_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -407,6 +458,7 @@ static int s6tuum3_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(ctx->panel.backlight))
 		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight), "failed to register backlight\n");
 
+	debugfs_create_file("s6tuum3_status", 0400, NULL, ctx, &s6tuum3_status_fops);
 	drm_panel_add(&ctx->panel);
 
 	ctx->dsc.dsc_version_major = 1;
-- 
