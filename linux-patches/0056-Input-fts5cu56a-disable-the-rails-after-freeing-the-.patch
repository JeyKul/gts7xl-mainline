From 27d976d01affa00b4599e0b6d8d3eb4484cd3b15 Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Wed, 4 Nov 2026 21:10:02 +0000
Subject: [PATCH 56/58] Input: fts5cu56a: disable the rails after freeing the
 interrupt

remove() cut the rails while the devm interrupt was still requested, so an event could read a dead device. A devm action runs in the right order and replaces the error path too.
---
 drivers/input/touchscreen/fts5cu56a.c | 39 +++++++++++++--------------
 1 file changed, 18 insertions(+), 21 deletions(-)

diff --git a/drivers/input/touchscreen/fts5cu56a.c b/drivers/input/touchscreen/fts5cu56a.c
index 5abbf347..6f497626 100644
--- a/drivers/input/touchscreen/fts5cu56a.c
+++ b/drivers/input/touchscreen/fts5cu56a.c
@@ -211,6 +211,13 @@ static int fts5_hw_init(struct fts5_data *ts)
 	return 0;
 }
 
+static void fts5_disable_supplies(void *data)
+{
+	struct fts5_data *ts = data;
+
+	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+}
+
 static int fts5_probe(struct i2c_client *client)
 {
 	struct fts5_data *ts;
@@ -233,18 +240,21 @@ static int fts5_probe(struct i2c_client *client)
 	if (ret)
 		return ret;
 
+	/* A devm action, so the interrupt is freed before the rails go off */
+	ret = devm_add_action_or_reset(&client->dev, fts5_disable_supplies, ts);
+	if (ret)
+		return ret;
+
 	/* power-on to firmware-ready is a few hundred ms */
 	msleep(300);
 
 	ret = fts5_hw_init(ts);
 	if (ret)
-		goto err_disable;
+		return ret;
 
 	ts->input = devm_input_allocate_device(&client->dev);
-	if (!ts->input) {
-		ret = -ENOMEM;
-		goto err_disable;
-	}
+	if (!ts->input)
+		return -ENOMEM;
 
 	ts->input->name = "STM FTS Touchscreen";
 	ts->input->id.bustype = BUS_I2C;
@@ -262,31 +272,19 @@ static int fts5_probe(struct i2c_client *client)
 	ret = input_mt_init_slots(ts->input, FTS_FINGER_MAX,
 				  INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
 	if (ret)
-		goto err_disable;
+		return ret;
 
 	ret = input_register_device(ts->input);
 	if (ret)
-		goto err_disable;
+		return ret;
 
 	ret = devm_request_threaded_irq(&client->dev, client->irq, NULL,
 					fts5_irq_handler,
 					IRQF_ONESHOT, "fts5cu56a", ts);
 	if (ret)
-		goto err_disable;
+		return ret;
 
-	i2c_set_clientdata(client, ts);
 	return 0;
-
-err_disable:
-	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
-	return ret;
-}
-
-static void fts5_remove(struct i2c_client *client)
-{
-	struct fts5_data *ts = i2c_get_clientdata(client);
-
-	regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
 }
 
 static const struct of_device_id fts5_of_match[] = {
@@ -308,7 +306,6 @@ static struct i2c_driver fts5_driver = {
 		.of_match_table = fts5_of_match,
 	},
 	.probe = fts5_probe,
-	.remove = fts5_remove,
 	.id_table = fts5_id,
 };
 module_i2c_driver(fts5_driver);
-- 
