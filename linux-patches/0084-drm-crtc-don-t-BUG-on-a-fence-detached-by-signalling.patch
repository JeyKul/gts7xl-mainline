From ff185be224013628b09f589055040769c70b8817 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 16 Nov 2026 00:53:21 +0100
Subject: [PATCH] drm/crtc: don't BUG on a fence detached by signalling

dma_fence_driver_name() checks the ops pointer, then calls the driver's
get_driver_name(). Signalling can set fence->ops to NULL in between:
fence_to_crtc() then saw NULL != &drm_crtc_fence_ops and hit BUG_ON.
Android's RenderThread queries fence names (SYNC_IOC_FILE_INFO) and
crashed the tablet this way. The crtc stays valid, only reject other ops.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/drm_crtc.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_crtc.c b/drivers/gpu/drm/drm_crtc.c
index 63ead8ba6..c1f31387a 100644
--- a/drivers/gpu/drm/drm_crtc.c
+++ b/drivers/gpu/drm/drm_crtc.c
@@ -158,7 +158,13 @@ static const struct dma_fence_ops drm_crtc_fence_ops;
 
 static struct drm_crtc *fence_to_crtc(struct dma_fence *fence)
 {
-	BUG_ON(rcu_access_pointer(fence->ops) != &drm_crtc_fence_ops);
+	const struct dma_fence_ops *ops = rcu_access_pointer(fence->ops);
+
+	/*
+	 * Signalling sets ops to NULL: that can race with a name query that
+	 * already passed dma_fence_driver_name()'s check. The crtc stays valid.
+	 */
+	BUG_ON(ops && ops != &drm_crtc_fence_ops);
 	return container_of(fence->extern_lock, struct drm_crtc, fence_lock);
 }
 
