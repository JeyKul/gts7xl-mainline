From 0ff17aebcc6b83b856b1b58d738205241267a4cb Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 8 Nov 2026 01:17:11 +0100
Subject: [PATCH 61/63] media: i2c: dw9807-vcm: skip system sleep while runtime
 suspended

The system sleep ops called the runtime suspend callback directly. A lens
that is already runtime suspended has its supply off, so the I2C writes
fail with -ENXIO and abort system suspend. Use pm_runtime_force_suspend()
and pm_runtime_force_resume() instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/dw9807-vcm.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 3437e3720..0a360578d 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -321,7 +321,8 @@ static const struct of_device_id dw9807_of_table[] = {
 MODULE_DEVICE_TABLE(of, dw9807_of_table);
 
 static const struct dev_pm_ops dw9807_pm_ops = {
-	SET_SYSTEM_SLEEP_PM_OPS(dw9807_vcm_suspend, dw9807_vcm_resume)
+	/* A runtime-suspended lens is unpowered: system sleep must not touch it again */
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
 	SET_RUNTIME_PM_OPS(dw9807_vcm_suspend, dw9807_vcm_resume, NULL)
 };
 
