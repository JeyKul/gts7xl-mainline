 obj-$(CONFIG_INPUT_YEALINK)		+= yealink.o
 obj-$(CONFIG_INPUT_IDEAPAD_SLIDEBAR)	+= ideapad_slidebar.o
+obj-$(CONFIG_INPUT_GTS7XL_EMERGENCY)	+= gts7xl-emergency.o
diff --git a/drivers/input/misc/gts7xl-emergency.c b/drivers/input/misc/gts7xl-emergency.c
new file mode 100644
index 000000000..f549a4613
--- /dev/null
+++ b/drivers/input/misc/gts7xl-emergency.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bring-up escape hatch: press Power + Volume Up + Volume Down together, then
+ * release them to reboot into recovery. Firing on release avoids the bootloader
+ * seeing the volume keys held, which selects download mode.
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/reboot.h>
+#include <linux/slab.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+
+#define EMERGENCY_FALLBACK_MS	5000
+
+static DEFINE_SPINLOCK(emergency_lock);
+static unsigned int emergency_down;
+static bool emergency_armed;
+static bool emergency_fired;
+
+static void emergency_fallback(struct timer_list *unused)
+{
+	pr_emerg("gts7xl-emergency: clean restart stuck, forcing reset\n");
+	emergency_restart();
+}
+static DEFINE_TIMER(emergency_timer, emergency_fallback);
+
+static void emergency_work_fn(struct work_struct *work)
+{
+	pr_emerg("gts7xl-emergency: rebooting to recovery\n");
+	mod_timer(&emergency_timer, jiffies + msecs_to_jiffies(EMERGENCY_FALLBACK_MS));
+	kernel_restart("recovery");
+}
+static DECLARE_WORK(emergency_work, emergency_work_fn);
+
+static void emergency_event(struct input_handle *handle, unsigned int type,
+			    unsigned int code, int value)
+{
+	unsigned long flags;
+	unsigned int bit;
+
+	if (type != EV_KEY || value == 2)
+		return;
+
+	switch (code) {
+	case KEY_POWER:
+		bit = BIT(0);
+		break;
+	case KEY_VOLUMEUP:
+		bit = BIT(1);
+		break;
+	case KEY_VOLUMEDOWN:
+		bit = BIT(2);
+		break;
+	default:
+		return;
+	}
+
+	spin_lock_irqsave(&emergency_lock, flags);
+	if (value)
+		emergency_down |= bit;
+	else
+		emergency_down &= ~bit;
+
+	if (emergency_down == (BIT(0) | BIT(1) | BIT(2)))
+		emergency_armed = true;
+
+	if (emergency_armed && !emergency_down && !emergency_fired) {
+		emergency_fired = true;
+		schedule_work(&emergency_work);
+	}
+	spin_unlock_irqrestore(&emergency_lock, flags);
+}
+
+static int emergency_connect(struct input_handler *handler, struct input_dev *dev,
+			     const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int ret;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "gts7xl-emergency";
+
+	ret = input_register_handle(handle);
+	if (ret)
+		goto err_free;
+
+	ret = input_open_device(handle);
+	if (ret)
+		goto err_unregister;
+
+	return 0;
+
+err_unregister:
+	input_unregister_handle(handle);
+err_free:
+	kfree(handle);
+	return ret;
+}
+
+static void emergency_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id emergency_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_KEYBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+		.keybit = { [BIT_WORD(KEY_POWER)] = BIT_MASK(KEY_POWER) },
+	},
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_KEYBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+		.keybit = { [BIT_WORD(KEY_VOLUMEUP)] = BIT_MASK(KEY_VOLUMEUP) },
+	},
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_KEYBIT,
+		.evbit = { BIT_MASK(EV_KEY) },
+		.keybit = { [BIT_WORD(KEY_VOLUMEDOWN)] = BIT_MASK(KEY_VOLUMEDOWN) },
+	},
+	{ }
+};
+
+static struct input_handler emergency_handler = {
+	.event = emergency_event,
+	.connect = emergency_connect,
+	.disconnect = emergency_disconnect,
+	.name = "gts7xl-emergency",
+	.id_table = emergency_ids,
+};
+
+static int __init emergency_init(void)
+{
+	return input_register_handler(&emergency_handler);
+}
+device_initcall(emergency_init);
