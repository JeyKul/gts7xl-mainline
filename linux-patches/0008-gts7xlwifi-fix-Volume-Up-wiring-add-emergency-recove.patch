--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -278,7 +278,23 @@ fuel-gauge@36 {
 	};
 };
 
+&gpio_keys {
+	pinctrl-0 = <&vol_up_l>;
+
+	key-vol-up {
+		gpios = <&pm8150l_gpios 3 GPIO_ACTIVE_LOW>;
+	};
+};
+
 &pm8150l_gpios {
+	vol_up_l: vol-up-l-state {
+		pins = "gpio3";
+		function = "normal";
+		power-source = <0>;
+		input-enable;
+		bias-pull-up;
+	};
+
 	max77705_int_default: max77705-int-default-state {
 		pins = "gpio11";
 		function = "normal";
