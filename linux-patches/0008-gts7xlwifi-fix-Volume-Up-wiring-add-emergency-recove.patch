 drivers/input/misc/Kconfig                    |   6 +
 drivers/input/misc/Makefile                   |   1 +
 drivers/input/misc/gts7xl-emergency.c         | 147 ++++++++++++++++++
 4 files changed, 170 insertions(+)
 create mode 100644 drivers/input/misc/gts7xl-emergency.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
