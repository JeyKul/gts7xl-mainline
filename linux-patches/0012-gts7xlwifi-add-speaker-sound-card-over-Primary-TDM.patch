From 05946ffa84bfc2f4055c5de5837f35c3bba3018a Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Sun, 1 Nov 2026 14:19:31 +0100
Subject: [PATCH 12/14] gts7xlwifi: add speaker sound card over Primary TDM

Add a TDM path to the sm8250 machine driver with one slot per side.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8250-samsung-gts7xlwifi.dts    | 75 +++++++++++++++++++
 sound/soc/qcom/sm8250.c                       | 55 ++++++++++++++
 2 files changed, 130 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 620adaa62..4fa10cc02 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -4,6 +4,8 @@
 
 #include <dt-bindings/clock/qcom,dispcc-sm8250.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include "sm8250-samsung-common.dtsi"
@@ -222,6 +224,56 @@ &adsp {
 	status = "okay";
 };
 
+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	model = "Galaxy Tab S7+";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pri_tdm_default>;
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	speakers-dai-link {
+		link-name = "Speakers";
+
+		cpu {
+			sound-dai = <&q6afedai PRIMARY_TDM_RX_0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+
+		codec {
+			sound-dai = <&cs35l41_fl 0>, <&cs35l41_fr 0>,
+				    <&cs35l41_rl 0>, <&cs35l41_rr 0>;
+		};
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <0>;
+	};
+};
+
+&q6afedai {
+	dai@2 {
+		reg = <PRIMARY_TDM_RX_0>;
+		qcom,tdm-sync-mode = <0>;
+		qcom,tdm-sync-src = <1>;
+		qcom,tdm-data-out = <0>;
+		qcom,tdm-invert-sync = <0>;
+		qcom,tdm-data-delay = <1>;
+		qcom,tdm-data-align = <0>;
+	};
+};
+
 &framebuffer {
 	panel = <&fb_panel>;
 
@@ -631,6 +683,29 @@ amp_default: amp-default-state {
 		bias-pull-up;
 	};
 
+	pri_tdm_default: pri-tdm-default-state {
+		clk-pins {
+			pins = "gpio138";
+			function = "mi2s0_sck";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio141";
+			function = "mi2s0_ws";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		dout-pins {
+			pins = "gpio140";
+			function = "mi2s0_data1";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	pogo_default: pogo-default-state {
 		int-pins {
 			pins = "gpio31";
diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 76dc3a3f4..ae1264175 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -17,6 +17,9 @@
 #include "sdw.h"
 
 #define MI2S_BCLK_RATE		1536000
+#define TDM_BCLK_RATE		6144000
+#define TDM_SLOTS		4
+#define TDM_SLOT_WIDTH		32
 
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
@@ -68,6 +71,44 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	channels->min = channels->max = 2;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id == PRIMARY_TDM_RX_0) {
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
+	}
+
+	return 0;
+}
+
+static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	static const unsigned int chmap[] = { 0, 1 };
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *dai;
+	int i, ret;
+
+	if (cpu_dai->id != PRIMARY_TDM_RX_0)
+		return 0;
+
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x3, TDM_SLOTS, TDM_SLOT_WIDTH);
+	if (ret)
+		return ret;
+
+	ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL, ARRAY_SIZE(chmap), chmap);
+	if (ret)
+		return ret;
+
+	/* Front and rear amps on one side share the left or right slot */
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		bool right = dai->component->name_prefix[1] == 'R';
+
+		ret = snd_soc_dai_set_tdm_slot(dai, 0, right ? BIT(1) : BIT(0),
+					       TDM_SLOTS, TDM_SLOT_WIDTH);
+		if (ret && ret != -ENOTSUPP)
+			return ret;
+	}
+
 	return 0;
 }
 
@@ -80,6 +121,19 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
 
 	switch (cpu_dai->id) {
+	case PRIMARY_TDM_RX_0: {
+		struct snd_soc_dai *dai;
+		int i;
+
+		snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+				       TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+		for_each_rtd_codec_dais(rtd, i, dai) {
+			snd_soc_dai_set_fmt(dai, SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_NB_NF |
+					    SND_SOC_DAIFMT_DSP_A);
+			snd_soc_dai_set_sysclk(dai, 0, TDM_BCLK_RATE, SND_SOC_CLOCK_IN);
+		}
+		break;
+	}
 	case PRIMARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
@@ -155,6 +209,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
+	.hw_params = sm8250_snd_hw_params,
 	.shutdown = qcom_snd_sdw_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
-- 
