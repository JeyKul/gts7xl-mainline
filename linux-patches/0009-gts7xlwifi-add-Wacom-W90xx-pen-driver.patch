 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
+obj-$(CONFIG_TOUCHSCREEN_SAMSUNG_W90XX)	+= samsung-w90xx.o
diff --git a/drivers/input/touchscreen/samsung-w90xx.c b/drivers/input/touchscreen/samsung-w90xx.c
new file mode 100644
index 000000000..f837fe8ae
--- /dev/null
+++ b/drivers/input/touchscreen/samsung-w90xx.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Wacom W90xx pen digitizer with Samsung firmware, Galaxy Tab S7+.
+ * Protocol taken from Samsung's downstream wacom_i2c driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#define W90XX_COORD_LEN		(16 + 1)
+#define W90XX_COORD_PACKET	1
+#define W90XX_CMD_START		0x31
+#define W90XX_MAX_X		26750
+#define W90XX_MAX_Y		16700
+#define W90XX_MAX_PRESSURE	4095
+#define W90XX_MAX_TILT		63
+
+struct w90xx {
+	struct i2c_client *client;
+	struct input_dev *input;
+	unsigned int tool;
+};
+
+static irqreturn_t w90xx_irq(int irq, void *dev_id)
+{
+	struct w90xx *pen = dev_id;
+	struct input_dev *input = pen->input;
+	u8 d[W90XX_COORD_LEN];
+	bool prox;
+	int pressure, ret;
+
+	ret = i2c_master_recv(pen->client, d, sizeof(d));
+	if (ret != sizeof(d)) {
+		dev_err_ratelimited(&pen->client->dev, "read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+
+	if ((d[0] & 0x0f) != W90XX_COORD_PACKET || !(d[0] & 0x80))
+		return IRQ_HANDLED;
+
+	prox = d[0] & 0x10;
+	pressure = ((d[5] & 0x0f) << 8) | d[6];
+
+	if (prox && !pen->tool)
+		pen->tool = (d[0] & 0x40) ? BTN_TOOL_RUBBER : BTN_TOOL_PEN;
+
+	if (pen->tool) {
+		input_report_abs(input, ABS_X, (d[1] << 8) | d[2]);
+		input_report_abs(input, ABS_Y, (d[3] << 8) | d[4]);
+		input_report_abs(input, ABS_PRESSURE, prox ? pressure : 0);
+		input_report_abs(input, ABS_DISTANCE, d[7]);
+		input_report_abs(input, ABS_TILT_X, (s8)d[8]);
+		input_report_abs(input, ABS_TILT_Y, (s8)d[9]);
+		input_report_key(input, BTN_TOUCH, prox && pressure > 0);
+		input_report_key(input, BTN_STYLUS, prox && (d[0] & 0x20));
+		input_report_key(input, pen->tool, prox);
+		input_sync(input);
+	}
+
+	if (!prox)
+		pen->tool = 0;
+
+	return IRQ_HANDLED;
+}
+
+static int w90xx_probe(struct i2c_client *client)
+{
+	static const u8 start = W90XX_CMD_START;
+	struct device *dev = &client->dev;
+	struct gpio_desc *fwe;
+	struct input_dev *input;
+	struct w90xx *pen;
+	int ret;
+
+	pen = devm_kzalloc(dev, sizeof(*pen), GFP_KERNEL);
+	if (!pen)
+		return -ENOMEM;
+	pen->client = client;
+
+	/* Must stay low or the digitizer enters its firmware update mode */
+	fwe = devm_gpiod_get(dev, "fwe", GPIOD_OUT_LOW);
+	if (IS_ERR(fwe))
+		return dev_err_probe(dev, PTR_ERR(fwe), "failed to get fwe gpio\n");
+
+	ret = devm_regulator_get_enable(dev, "vdd");
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable vdd\n");
+	msleep(200);
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+	pen->input = input;
+
+	input->name = "Wacom W90xx Pen";
+	input->id.bustype = BUS_I2C;
+	__set_bit(INPUT_PROP_DIRECT, input->propbit);
+	input_set_capability(input, EV_KEY, BTN_TOUCH);
+	input_set_capability(input, EV_KEY, BTN_STYLUS);
+	input_set_capability(input, EV_KEY, BTN_TOOL_PEN);
+	input_set_capability(input, EV_KEY, BTN_TOOL_RUBBER);
+	input_set_abs_params(input, ABS_X, 0, W90XX_MAX_X, 4, 0);
+	input_set_abs_params(input, ABS_Y, 0, W90XX_MAX_Y, 4, 0);
+	/* Panel is 273x167mm */
+	input_abs_set_res(input, ABS_X, W90XX_MAX_X / 273);
+	input_abs_set_res(input, ABS_Y, W90XX_MAX_Y / 167);
+	input_set_abs_params(input, ABS_PRESSURE, 0, W90XX_MAX_PRESSURE, 0, 0);
+	input_set_abs_params(input, ABS_DISTANCE, 0, 255, 0, 0);
+	input_set_abs_params(input, ABS_TILT_X, -W90XX_MAX_TILT, W90XX_MAX_TILT, 0, 0);
+	input_set_abs_params(input, ABS_TILT_Y, -W90XX_MAX_TILT, W90XX_MAX_TILT, 0, 0);
+
+	ret = input_register_device(input);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, w90xx_irq,
+					IRQF_ONESHOT, "w90xx", pen);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	ret = i2c_master_send(client, &start, 1);
+	if (ret != 1)
+		return dev_err_probe(dev, ret < 0 ? ret : -EIO, "digitizer not responding\n");
+
+	dev_info(dev, "pen digitizer started\n");
+	return 0;
+}
+
+static const struct of_device_id w90xx_of_match[] = {
+	{ .compatible = "samsung,wacom-w90xx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, w90xx_of_match);
+
+static struct i2c_driver w90xx_driver = {
+	.driver = {
+		.name = "samsung-w90xx",
+		.of_match_table = w90xx_of_match,
+	},
+	.probe = w90xx_probe,
+};
+module_i2c_driver(w90xx_driver);
+
+MODULE_DESCRIPTION("Wacom W90xx pen digitizer driver");
+MODULE_LICENSE("GPL");
-- 
