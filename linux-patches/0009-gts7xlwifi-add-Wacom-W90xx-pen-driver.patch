From 772f918bda05f5e378ebec21287d6d698527f1ff Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Sun, 1 Nov 2026 13:51:59 +0100
Subject: [PATCH 09/12] gts7xlwifi: add Wacom W90xx pen driver

Protocol from Samsung's driver. Axis range calibrated by hand, because the
stock device tree values did not match this digitizer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8250-samsung-gts7xlwifi.dts    |  35 ++++
 drivers/input/touchscreen/Kconfig             |   6 +
 drivers/input/touchscreen/Makefile            |   1 +
 drivers/input/touchscreen/samsung-w90xx.c     | 151 ++++++++++++++++++
 4 files changed, 193 insertions(+)
 create mode 100644 drivers/input/touchscreen/samsung-w90xx.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 83cdf8b72..f799ab08b 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -81,6 +81,15 @@ vreg_pmu_pcie_1p8: ldo9 {
 		};
 	};
 
+	vdd_spen: spen-3v3-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_spen_3p3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	pogo_vdd: pogo-vdd-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "pogo_vdd_3v3";
@@ -249,6 +258,26 @@ touchscreen@49 {
 	};
 };
 
+&qupv3_id_2 {
+	status = "okay";
+};
+
+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	pen@56 {
+		compatible = "samsung,wacom-w90xx";
+		reg = <0x56>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <136 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&vdd_spen>;
+		fwe-gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pen_default>;
+	};
+};
+
 &i2c0 {
 	status = "okay";
 
@@ -452,6 +481,12 @@ bt_en_state: bt-en-state {
 		bias-disable;
 	};
 
+	pen_default: pen-default-state {
+		pins = "gpio136";
+		function = "gpio";
+		bias-disable;
+	};
+
 	pogo_default: pogo-default-state {
 		int-pins {
 			pins = "gpio31";
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 18debd544..258124891 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1247,6 +1247,12 @@ config TOUCHSCREEN_FTS5CU56A
 	  Minimal driver for STM FTS5CU56A and FTS1BA90A touch controllers
 	  with Samsung TSP firmware.
 
+config TOUCHSCREEN_SAMSUNG_W90XX
+	tristate "Wacom W90xx pen with Samsung firmware"
+	depends on I2C
+	help
+	  Pen digitizer in the Galaxy Tab S7+.
+
 config TOUCHSCREEN_STMFTS
 	tristate "STMicroelectronics STMFTS touchscreen"
 	depends on I2C
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index 7912b1238..4d0e3750e 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -120,3 +120,4 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
