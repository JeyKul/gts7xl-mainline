From c78ab52dd16b32942cde43e10a960d99cd7d14ec Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 1 Nov 2026 20:38:17 +0100
Subject: [PATCH] drm/panel: s6tuum3: fix brightness range, add 120Hz and 60Hz
 modes

---
 drivers/gpu/drm/panel/panel-samsung-s6tuum3.c | 88 +++++++++++++++----
 1 file changed, 69 insertions(+), 19 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c b/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
index 884204409..da10b0dbb 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6tuum3.c
@@ -14,13 +14,15 @@
 
 #include <drm/display/drm_dsc.h>
 #include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
-#include <drm/drm_probe_helper.h>
 
-/* Top of the stock normal range, wrdisbv 0xdd8 */
-#define S6TUUM3_MAX_BRIGHTNESS	3544
+/* Top of the stock normal range: 51h takes 11 bits, 420 cd */
+#define S6TUUM3_MAX_BRIGHTNESS	2047
 
 struct s6tuum3 {
 	struct drm_panel panel;
@@ -29,6 +31,7 @@ struct s6tuum3 {
 	struct gpio_desc *reset;
 	struct gpio_desc *tcon_ready;
 	struct drm_dsc_config dsc;
+	struct drm_connector *connector;
 	bool first_on_done;
 	bool enabled;
 	struct delayed_work on_work;
@@ -50,6 +53,17 @@ static inline struct s6tuum3 *to_s6tuum3(struct drm_panel *panel)
 	return container_of(panel, struct s6tuum3, panel);
 }
 
+/* The refresh rate comes from the mode being enabled */
+static bool s6tuum3_is_60hz(struct s6tuum3 *ctx)
+{
+	struct drm_connector_state *state = ctx->connector ? ctx->connector->state : NULL;
+
+	if (!state || !state->crtc)
+		return false;
+
+	return drm_mode_vrefresh(&state->crtc->state->adjusted_mode) <= 60;
+}
+
 static int s6tuum3_prepare(struct drm_panel *panel)
 {
 	struct s6tuum3 *ctx = to_s6tuum3(panel);
@@ -75,8 +89,11 @@ static int s6tuum3_prepare(struct drm_panel *panel)
 	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x4d);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x98, 0x00);
-	/* Stock wqxga60hs; the bootloader's tear check also points to 60Hz */
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
+	/* Frequency: 20h is 120Hz, 00h is 60Hz */
+	if (s6tuum3_is_60hz(ctx))
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
+	else
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x20);
 	mipi_dsi_msleep(&dsi_ctx, 50);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x08);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x78, 0x30);
@@ -185,24 +202,57 @@ static int s6tuum3_unprepare(struct drm_panel *panel)
 	return 0;
 }
 
-static const struct drm_display_mode s6tuum3_mode = {
-	.clock = (2800 + 224 + 320 + 212) * (1752 + 224 + 320 + 212) * 60 / 1000,
-	.hdisplay = 2800,
-	.hsync_start = 2800 + 224,
-	.hsync_end = 2800 + 224 + 320,
-	.htotal = 2800 + 224 + 320 + 212,
-	.vdisplay = 1752,
-	.vsync_start = 1752 + 224,
-	.vsync_end = 1752 + 224 + 320,
-	.vtotal = 1752 + 224 + 320 + 212,
-	.width_mm = 267,
-	.height_mm = 167,
-	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+static const struct drm_display_mode s6tuum3_modes[] = {
+	{
+		.clock = (2800 + 64 + 64 + 48) * (1752 + 48 + 64 + 48) * 120 / 1000,
+		.hdisplay = 2800,
+		.hsync_start = 2800 + 64,
+		.hsync_end = 2800 + 64 + 64,
+		.htotal = 2800 + 64 + 64 + 48,
+		.vdisplay = 1752,
+		.vsync_start = 1752 + 48,
+		.vsync_end = 1752 + 48 + 64,
+		.vtotal = 1752 + 48 + 64 + 48,
+		.width_mm = 267,
+		.height_mm = 167,
+		.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	}, {
+		.clock = (2800 + 224 + 320 + 212) * (1752 + 224 + 320 + 212) * 60 / 1000,
+		.hdisplay = 2800,
+		.hsync_start = 2800 + 224,
+		.hsync_end = 2800 + 224 + 320,
+		.htotal = 2800 + 224 + 320 + 212,
+		.vdisplay = 1752,
+		.vsync_start = 1752 + 224,
+		.vsync_end = 1752 + 224 + 320,
+		.vtotal = 1752 + 224 + 320 + 212,
+		.width_mm = 267,
+		.height_mm = 167,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
 };
 
 static int s6tuum3_get_modes(struct drm_panel *panel, struct drm_connector *connector)
 {
-	return drm_connector_helper_get_modes_fixed(connector, &s6tuum3_mode);
+	struct s6tuum3 *ctx = to_s6tuum3(panel);
+	int i;
+
+	ctx->connector = connector;
+	connector->display_info.width_mm = 267;
+	connector->display_info.height_mm = 167;
+
+	for (i = 0; i < ARRAY_SIZE(s6tuum3_modes); i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &s6tuum3_modes[i]);
+		if (!mode)
+			return i;
+
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	return ARRAY_SIZE(s6tuum3_modes);
 }
 
 static const struct drm_panel_funcs s6tuum3_funcs = {
-- 
2.56.0

