 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi-usbhost.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi-typec.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-r8q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-x1q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-sony-xperia-edo-pdx203.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-typec.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-typec.dts
