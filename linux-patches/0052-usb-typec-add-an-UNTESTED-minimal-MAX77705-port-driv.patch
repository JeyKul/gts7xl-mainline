--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-typec.dts
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UNTESTED bring-up variant for stage (c) in docs/usbc-dp-research.md: the
+ * max77705-typec driver owns attach and roles. Not built by CI or the
+ * installer. Needs CONFIG_TYPEC_MAX77705=m. Until that module loads, dwc3
+ * stays a peripheral, so the gadget debug path survives a failed probe.
+ *
+ * USB 2.0 only. Stage c1 leaves the QMP PHY out; set GTS7XL_TYPEC_QMP to 1
+ * for c2, the orientation switch. The rail below is new to this board, and
+ * NOTES.md records dark panels from defining rails, so that is its own step.
+ */
+
+#define GTS7XL_TYPEC_QMP 0
+
+#include <dt-bindings/usb/pd.h>
+#include "sm8250-samsung-gts7xlwifi.dts"
+
+&i2c0 {
+	typec@25 {
+		compatible = "maxim,max77705-typec";
+		reg = <0x25>;
+		interrupt-parent = <&max77705>;
+		interrupts = <3>;
+		vbus-supply = <&max77705_otg_vbus>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			op-sink-microwatt = <15000000>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					max77705_typec_hs: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs_out>;
+					};
+				};
+
+#if GTS7XL_TYPEC_QMP
+				port@1 {
+					reg = <1>;
+
+					max77705_typec_ss: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+#endif
+			};
+		};
+	};
+};
+
+&max77705_charger {
+	max77705_otg_vbus: usb-otg-vbus {
+		regulator-name = "usb-otg-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+};
+
+&usb_1_dwc3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+};
+
+&usb_1_dwc3_hs_out {
+	remote-endpoint = <&max77705_typec_hs>;
+};
+
+#if GTS7XL_TYPEC_QMP
+&apps_rsc {
+	regulators-0 {
+		vreg_l18a_0p92: ldo18 {
+			regulator-name = "vreg_l18a_0p92";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+&usb_1_qmpphy {
+	vdda-phy-supply = <&vreg_l18a_0p92>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&max77705_typec_ss>;
+};
+#endif
