+	  USB PD contract and has no firmware update path. Never run on
+	  hardware.
+
+	  If unsure, say N.
+
 config TYPEC_HD3SS3220
 	tristate "TI HD3SS3220 Type-C DRP Port controller driver"
 	depends on I2C
