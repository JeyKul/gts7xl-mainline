From 7fdaa24d97e19a856ca2fb1d8818d05c906771c0 Mon Sep 17 00:00:00 2001
From: Claudius <claudiusthebot@gmail.com>
Date: Wed, 4 Nov 2026 19:56:20 +0000
Subject: [PATCH 51/53] gts7xlwifi: add a forced USB host test DTB

Separate DTB so default builds keep the USB gadget debug path. USB 2.0
only, as the base board. Untested, see docs/usbc-dp-research.md stage (a).
---
 arch/arm64/boot/dts/qcom/Makefile                |  1 +
 .../qcom/sm8250-samsung-gts7xlwifi-usbhost.dts   | 16 ++++++++++++++++
 2 files changed, 17 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-usbhost.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 92f3a645c..e5f84c6b7 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -365,6 +365,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-sony-xperia-kumano-griffin.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-gts7xlwifi-usbhost.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-r8q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-x1q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-sony-xperia-edo-pdx203.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-usbhost.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-usbhost.dts
new file mode 100644
index 000000000..19907153e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi-usbhost.dts
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UNTESTED bring-up variant: USB-C port forced to USB 2.0 host, for
+ * stage (a) in docs/usbc-dp-research.md. Not built by CI or the installer.
+ * The default DTB stays in peripheral mode, because the USB serial and
+ * network gadget are the debug path; this variant has neither.
+ *
+ * No VBUS comes from the tablet here, so a device or hub needs its upstream
+ * VBUS from elsewhere: a dock fed by a PD charger, or stage (b).
+ */
+
+#include "sm8250-samsung-gts7xlwifi.dts"
+
+&usb_1_dwc3 {
+	dr_mode = "host";
+};
-- 
