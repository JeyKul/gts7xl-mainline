diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index b292dfd26..2c13b3318 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -853,6 +853,8 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 		/* Do not swap RGB colors */
 		data = DSI_CMD_CFG0_RGB_SWAP(SWAP_RGB);
 		data |= DSI_CMD_CFG0_DST_FORMAT(dsi_get_cmd_fmt(mipi_fmt));
+		if (msm_host->dsc)
+			data |= DSI_CMD_CFG0_INTERLEAVE_MAX(1);
 		dsi_write(msm_host, REG_DSI_CMD_CFG0, data);
 
 		data = DSI_CMD_CFG1_WR_MEM_START(MIPI_DCS_WRITE_MEMORY_START) |
@@ -881,13 +883,15 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 
 	data = 0;
 	/* Always assume dedicated TE pin */
-	data |= DSI_TRIG_CTRL_TE;
+	/* The bootloader syncs in the tear check block, not on the DSI trigger */
+	if (!msm_host->dsc)
+		data |= DSI_TRIG_CTRL_TE;
 	data |= DSI_TRIG_CTRL_MDP_TRIGGER(TRIGGER_NONE);
 	data |= DSI_TRIG_CTRL_DMA_TRIGGER(TRIGGER_SW);
 	data |= DSI_TRIG_CTRL_STREAM(msm_host->channel);
 	if ((cfg_hnd->major == MSM_DSI_VER_MAJOR_6G) &&
 		(cfg_hnd->minor >= MSM_DSI_6G_VER_MINOR_V1_2))
-		data |= DSI_TRIG_CTRL_BLOCK_DMA_WITHIN_FRAME;
+		data |= msm_host->dsc ? 0 : DSI_TRIG_CTRL_BLOCK_DMA_WITHIN_FRAME;
 	dsi_write(msm_host, REG_DSI_TRIG_CTRL, data);
 
 	data = DSI_CLKOUT_TIMING_CTRL_T_CLK_POST(phy_shared_timings->clk_post) |
@@ -930,6 +934,12 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 			lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
 	}
 
+	/* The bootloader runs this panel without PHY-selected HS requests */
+	if (flags & MIPI_DSI_CLOCK_NON_CONTINUOUS) {
+		lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
+		dsi_write(msm_host, REG_DSI_LANE_CTRL, lane_ctrl & ~DSI_LANE_CTRL_HS_REQ_SEL_PHY);
+	}
+
 	data |= DSI_CTRL_ENABLE;
 
 	dsi_write(msm_host, REG_DSI_CTRL, data);
