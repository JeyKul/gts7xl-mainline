From 85244add842423716f788eaa295c7a9c0b1def24 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 8 Nov 2026 02:19:16 +0100
Subject: [PATCH] arm64: dts: qcom: gts7xlwifi: enable the video codec

Venus/iris with the tablet's own signed firmware, which userspace copies
from its apnhlos partition.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 4e2ba2876..fb400f1f2 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -663,6 +663,12 @@ uart3: serial@98c000 {
 	};
 };
 
+&venus {
+	/* Signed for this tablet: copied from its apnhlos partition on first boot */
+	firmware-name = "qcom/sm8250/gts7xl/venus.mbn";
+	status = "okay";
+};
+
 &uart6 {
 	status = "okay";
 
-- 
2.56.0

