From 2bef8bd63a5c6b8a10df260b64f7f7dd07135967 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 2 Nov 2026 20:24:11 +0100
Subject: [PATCH] gts7xlwifi: add the rear camera

s5k3m5 on CCI0 with its data lanes wired in reverse. Use the stock sensor mode:
19.2MHz in, 691.2MHz link, 4128x3096, no phase detect output. Raise the camera
NoC clock from the 19.2MHz the bootloader leaves, or the VFE reports CCIF
violations and writes nothing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8250-samsung-gts7xlwifi.dts    | 102 ++++++++++
 drivers/media/i2c/s5k3m5.c                    | 179 +++++-------------
 2 files changed, 146 insertions(+), 135 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index b1b43c0fe..eeb94a28a 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -2,6 +2,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/clock/qcom,dispcc-sm8250.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
@@ -97,6 +98,24 @@ vdd_spen: spen-3v3-regulator {
 		enable-active-high;
 	};
 
+	cam_rear_vana: cam-rear-vana-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_rear_vana";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	cam_vio: cam-vio-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	vibrator {
 		compatible = "regulator-haptic";
 		haptic-supply = <&vreg_l7c_2p856>;
@@ -331,6 +350,66 @@ data-pins {
 	};
 };
 
+&camss {
+	/* The driver leaves these at the 19.2MHz the bootloader sets here */
+	assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK_SRC>,
+			  <&camcc CAM_CC_SLOW_AHB_CLK_SRC>;
+	assigned-clock-rates = <400000000>, <80000000>;
+
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+
+	ports {
+		port@0 {
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				/* Wired in reverse on this board */
+				data-lanes = <3 2 1 0>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				remote-endpoint = <&cam_rear_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	/* Rear 13MP. Stock only switches VANA and VIO, the digital rail hangs off VANA */
+	camera@2d {
+		compatible = "samsung,s5k3m5";
+		reg = <0x2d>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 73 GPIO_ACTIVE_LOW>;
+
+		afvdd-supply = <&cam_rear_vana>;
+		vdda-supply = <&cam_rear_vana>;
+		vddd-supply = <&cam_rear_vana>;
+		vddio-supply = <&cam_vio>;
+
+		pinctrl-0 = <&cam_rear_default>;
+		pinctrl-names = "default";
+
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			cam_rear_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <691200000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
 &q6asmdai {
 	dai@0 {
 		reg = <0>;
@@ -921,6 +1000,29 @@ dout-pins {
 		};
 	};
 
+	cam_rear_default: cam-rear-default-state {
+		mclk-pins {
+			pins = "gpio94";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rst-pins {
+			pins = "gpio73";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		pwr-pins {
+			pins = "gpio37", "gpio39";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	hall_default: hall-default-state {
 		pins = "gpio157";
 		function = "gpio";
