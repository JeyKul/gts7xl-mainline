From d626479a8db55224b89e7204cc5f576927dbcff6 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 8 Nov 2026 01:17:11 +0100
Subject: [PATCH 63/63] arm64: dts: qcom: gts7xlwifi: drop the flip-cover lid
 switch

TLMM 157 never toggles for the Book Cover Keyboard, which now reports
the lid itself, and UPower follows only the first lid switch it finds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts  | 16 ++++++----------
 1 file changed, 6 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 4ecb28b18..0c554459a 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -981,16 +981,12 @@ fuel-gauge@36 {
 };
 
 &gpio_keys {
-	pinctrl-0 = <&vol_up_l>, <&hall_default>;
-
-	switch-lid {
-		label = "Cover";
-		gpios = <&tlmm 157 GPIO_ACTIVE_LOW>;
-		linux,input-type = <EV_SW>;
-		linux,code = <SW_LID>;
-		debounce-interval = <15>;
-		wakeup-source;
-	};
+	/*
+	 * No lid switch on the flip-cover hall (TLMM 157): it never toggles for the
+	 * Book Cover Keyboard, which reports the lid over pogo instead, and UPower
+	 * follows only the first lid switch it finds.
+	 */
+	pinctrl-0 = <&vol_up_l>;
 
 	key-vol-up {
 		gpios = <&pm8150l_gpios 3 GPIO_ACTIVE_LOW>;
-- 
2.56.0

