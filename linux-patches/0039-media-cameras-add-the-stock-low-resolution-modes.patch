+	struct s5ktab *s = to_s5ktab(sd);
+	const struct s5ktab_mode *m;
+	unsigned int i;
+
+	m = &s->data->modes[0];
+	for (i = 1; i < s->data->num_modes; i++) {
+		const struct s5ktab_mode *c = &s->data->modes[i];
+
+		if (abs((int)c->width - (int)fmt->format.width) +
+		    abs((int)c->height - (int)fmt->format.height) <
+		    abs((int)m->width - (int)fmt->format.width) +
+		    abs((int)m->height - (int)fmt->format.height))
+			m = c;
+	}
+	s5ktab_fill_format(s, m, &fmt->format);
 	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || m == s->mode)
+		return 0;
+
+	s->mode = m;
+	__v4l2_ctrl_modify_range(s->hblank, m->hts - m->width, m->hts - m->width, 1,
+				 m->hts - m->width);
+	__v4l2_ctrl_modify_range(s->vblank, m->vts - m->height, S5KTAB_VTS_MAX - m->height, 1,
+				 m->vts - m->height);
+	__v4l2_ctrl_s_ctrl(s->vblank, m->vts - m->height);
+	__v4l2_ctrl_modify_range(s->exposure, 2, m->vts - S5KTAB_EXPOSURE_MARGIN, 1, m->vts / 4);
+	__v4l2_ctrl_s_ctrl(s->exposure, m->vts / 4);
 	return 0;
 }
 
