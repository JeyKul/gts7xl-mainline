From d38bac5d72c59b3ffdf1edd633653802160f2100 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Wed, 4 Nov 2026 20:15:21 +0100
Subject: [PATCH 46/50] Input: samsung-stm32-pogo: report trackpad axes
 unrotated

Tested on the Book Cover Keyboard: the raw x/y already match the
pointer directions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/keyboard/samsung-stm32-pogo.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/input/keyboard/samsung-stm32-pogo.c b/drivers/input/keyboard/samsung-stm32-pogo.c
index 323d0fe23..335e533c5 100644
--- a/drivers/input/keyboard/samsung-stm32-pogo.c
+++ b/drivers/input/keyboard/samsung-stm32-pogo.c
@@ -103,9 +103,8 @@ static void pogo_report_touchpad(struct pogo_kbd *kbd, const u8 *data, unsigned
 		input_mt_slot(tp, i);
 		input_mt_report_slot_state(tp, MT_TOOL_FINGER, down);
 		if (down) {
-			/* The sensor is mounted rotated, as in the stock driver */
-			input_report_abs(tp, ABS_MT_POSITION_X, POGO_TP_MAX_Y - 1 - y);
-			input_report_abs(tp, ABS_MT_POSITION_Y, x);
+			input_report_abs(tp, ABS_MT_POSITION_X, x);
+			input_report_abs(tp, ABS_MT_POSITION_Y, y);
 			input_report_abs(tp, ABS_MT_TOUCH_MAJOR, max_t(int, c[4], 45));
 		}
 	}
@@ -452,8 +451,8 @@ static int pogo_probe(struct i2c_client *client)
 	kbd->touchpad->id.bustype = BUS_I2C;
 	input_set_capability(kbd->touchpad, EV_KEY, BTN_LEFT);
 	__set_bit(INPUT_PROP_BUTTONPAD, kbd->touchpad->propbit);
-	input_set_abs_params(kbd->touchpad, ABS_MT_POSITION_X, 0, POGO_TP_MAX_Y - 1, 0, 0);
-	input_set_abs_params(kbd->touchpad, ABS_MT_POSITION_Y, 0, POGO_TP_MAX_X - 1, 0, 0);
+	input_set_abs_params(kbd->touchpad, ABS_MT_POSITION_X, 0, POGO_TP_MAX_X - 1, 0, 0);
+	input_set_abs_params(kbd->touchpad, ABS_MT_POSITION_Y, 0, POGO_TP_MAX_Y - 1, 0, 0);
 	input_set_abs_params(kbd->touchpad, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
 
 	ret = input_mt_init_slots(kbd->touchpad, POGO_TP_FINGERS, INPUT_MT_POINTER);
-- 
