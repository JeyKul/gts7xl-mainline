 }
 
+static void pogo_report_touchpad(struct pogo_kbd *kbd, const u8 *data, unsigned int len)
+{
+	struct input_dev *tp = kbd->touchpad;
+	u16 status;
+	unsigned int i;
+
+	if (len != POGO_TP_EVENT_SIZE)
+		return;
+
+	status = get_unaligned_le16(data);
+	if (status & POGO_TP_ICON_EVENT)
+		input_report_key(tp, BTN_LEFT, data[3] & POGO_TP_ICON_DOWN);
+
+	for (i = 0; i < POGO_TP_FINGERS; i++) {
+		const u8 *c = data + 4 + i * 6;
+		bool down = c[5] & POGO_TP_FINGER_EXIST;
+		unsigned int x = get_unaligned_le16(c);
+		unsigned int y = get_unaligned_le16(c + 2);
+
+		if (down && (x >= POGO_TP_MAX_X || y >= POGO_TP_MAX_Y))
+			continue;
+
+		input_mt_slot(tp, i);
+		input_mt_report_slot_state(tp, MT_TOOL_FINGER, down);
+		if (down) {
+			/* The sensor is mounted rotated, as in the stock driver */
+			input_report_abs(tp, ABS_MT_POSITION_X, POGO_TP_MAX_Y - 1 - y);
+			input_report_abs(tp, ABS_MT_POSITION_Y, x);
+			input_report_abs(tp, ABS_MT_TOUCH_MAJOR, max_t(int, c[4], 45));
+		}
+	}
+
+	input_mt_sync_frame(tp);
+	input_sync(tp);
+}
+
+static void pogo_release_touchpad(struct pogo_kbd *kbd)
+{
+	unsigned int i;
+
+	for (i = 0; i < POGO_TP_FINGERS; i++) {
+		input_mt_slot(kbd->touchpad, i);
+		input_mt_report_slot_state(kbd->touchpad, MT_TOOL_FINGER, false);
+	}
+	input_report_key(kbd->touchpad, BTN_LEFT, 0);
+	input_mt_sync_frame(kbd->touchpad);
+	input_sync(kbd->touchpad);
+}
+
 static void pogo_report_keys(struct pogo_kbd *kbd, const u8 *data, unsigned int len)
 {
 	unsigned int i;
