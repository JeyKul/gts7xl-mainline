+#define POGO_TP_ICON_EVENT	BIT(15)
+#define POGO_TP_ICON_DOWN	BIT(0)
+#define POGO_TP_FINGER_EXIST	BIT(0)
+
 #define POGO_KEY_PRESS		BIT(0)
