+	}
+
 	/* Noise from the connector settling */
 	if (size >= 3 && data[0] == 0x03 && data[1] == 0x00 && data[2] == 0x05)
 		return IRQ_HANDLED;
 
 	switch (hdr[2]) {
+	case POGO_ID_TOUCHPAD:
+		pogo_report_touchpad(kbd, data, size);
+		break;
 	case POGO_ID_KEYPAD:
 		pogo_report_keys(kbd, data, size);
 		break;
 	case POGO_ID_HALL:
 		pogo_release_keys(kbd);
+		pogo_release_touchpad(kbd);
 		break;
 	default:
 		break;
@@ -210,6 +279,7 @@ static irqreturn_t pogo_irq(int irq, void *dev_id)
 
 err:
 	pogo_release_keys(kbd);
+	pogo_release_touchpad(kbd);
 	return IRQ_HANDLED;
 }
 
@@ -227,13 +297,11 @@ static void pogo_set_connected(struct pogo_kbd *kbd, bool connected)
 			return;
 		}
 		msleep(50);
