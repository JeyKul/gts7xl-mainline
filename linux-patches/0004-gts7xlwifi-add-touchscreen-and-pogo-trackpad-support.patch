@@ -187,20 +242,34 @@ static irqreturn_t pogo_irq(int irq, void *dev_id)
 
 	ret = pogo_xfer(client, NULL, 0, data, size);
 	if (ret) {
-		dev_err_ratelimited(&client->dev, "payload read failed: %d\n", ret);
+		dev_err_ratelimited(&client->dev, "payload read failed: %d (id=%u len=%u)\n", ret, hdr[2], size);
 		goto err;
 	}
 
+	{
+		static int logged;
+
+		if (hdr[2] != POGO_ID_KEYPAD && logged < POGO_FRAME_LOG) {
+			logged++;
+			dev_info(&client->dev, "frame id=%u len=%u: %*ph\n", hdr[2], size,
+				 min_t(int, size, 24), data);
