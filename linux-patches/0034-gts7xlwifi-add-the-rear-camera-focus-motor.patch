From 7fc699d6282d96e3c88cae9f10865e8180afde89 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Mon, 2 Nov 2026 20:54:52 +0100
Subject: [PATCH] gts7xlwifi: add the rear camera focus motor

A dw9808 on CCI1 bus 1, driven by dw9807-vcm. The driver now powers its vdd
supply and waits for the chip to wake up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/sm8250-samsung-gts7xlwifi.dts    | 16 ++++++++++++++
 drivers/media/i2c/dw9807-vcm.c                | 21 +++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index eeb94a28a..18ca12187 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -101,6 +101,7 @@ vdd_spen: spen-3v3-regulator {
 	cam_rear_vana: cam-rear-vana-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "cam_rear_vana";
+		vin-supply = <&cam_vio>;
 		regulator-min-microvolt = <2800000>;
 		regulator-max-microvolt = <2800000>;
 		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
@@ -377,6 +378,19 @@ &cci0 {
 	status = "okay";
 };
 
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	/* Rear camera focus motor, a dw9808 */
+	cam_rear_focus: lens@c {
+		compatible = "dongwoon,dw9807-vcm";
+		reg = <0x0c>;
+		vdd-supply = <&cam_rear_vana>;
+	};
+};
+
 &cci0_i2c0 {
 	/* Rear 13MP. Stock only switches VANA and VIO, the digital rail hangs off VANA */
 	camera@2d {
@@ -397,6 +411,8 @@ camera@2d {
 		pinctrl-0 = <&cam_rear_default>;
 		pinctrl-names = "default";
 
+		lens-focus = <&cam_rear_focus>;
+
 		orientation = <1>;
 		rotation = <90>;
 
diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 4148009e0..3437e3720 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -7,6 +7,7 @@
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 
@@ -39,6 +40,7 @@
 #define MAX_RETRY		10
 
 struct dw9807_device {
+	struct regulator *vdd;
 	struct v4l2_ctrl_handler ctrls_vcm;
 	struct v4l2_subdev sd;
 	u16 current_val;
@@ -185,6 +187,10 @@ static int dw9807_probe(struct i2c_client *client)
 	if (dw9807_dev == NULL)
 		return -ENOMEM;
 
+	dw9807_dev->vdd = devm_regulator_get(&client->dev, "vdd");
+	if (IS_ERR(dw9807_dev->vdd))
+		return PTR_ERR(dw9807_dev->vdd);
+
 	v4l2_i2c_subdev_init(&dw9807_dev->sd, client, &dw9807_ops);
 	dw9807_dev->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	dw9807_dev->sd.internal_ops = &dw9807_int_ops;
@@ -203,6 +209,11 @@ static int dw9807_probe(struct i2c_client *client)
 	if (rval < 0)
 		goto err_cleanup;
 
+	rval = regulator_enable(dw9807_dev->vdd);
+	if (rval)
+		goto err_cleanup;
+	usleep_range(12000, 15000);
+
 	pm_runtime_set_active(&client->dev);
 	pm_runtime_enable(&client->dev);
 	pm_runtime_idle(&client->dev);
@@ -254,6 +265,8 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 		return ret;
 	}
 
+	regulator_disable(dw9807_dev->vdd);
+
 	return 0;
 }
 
@@ -271,6 +284,14 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 	const char tx_data[2] = { DW9807_CTL_ADDR, 0x00 };
 	int ret, val;
 
+
+	ret = regulator_enable(dw9807_dev->vdd);
+	if (ret)
+		return ret;
+
+	/* The dw9808 needs time to wake up before it answers */
+	usleep_range(12000, 15000);
+
 	/* Power on */
 	ret = i2c_master_send(client, tx_data, sizeof(tx_data));
 	if (ret < 0) {
-- 
2.56.0

