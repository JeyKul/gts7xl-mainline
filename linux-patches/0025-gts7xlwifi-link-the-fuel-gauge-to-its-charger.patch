From baf98c934696a9ba8df2a7b0134a716f948d6eac Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 1 Nov 2026 21:30:05 +0100
Subject: [PATCH] gts7xlwifi: link the fuel gauge to its charger

---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index 93ebece43..0a10a2f6a 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -534,6 +534,7 @@ fuel-gauge@36 {
 		compatible = "maxim,max77705-battery";
 		reg = <0x36>;
 		maxim,rsns-microohm = <5000>;
+		power-supplies = <&max77705_charger>;
 	};
 };
 
