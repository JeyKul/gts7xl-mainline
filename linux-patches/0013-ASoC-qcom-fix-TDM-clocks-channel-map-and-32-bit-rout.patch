From 3e754d4f2dd61cf0cf5c8242779792f160b3b271 Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Sun, 1 Nov 2026 14:29:47 +0100
Subject: [PATCH 13/15] ASoC: qcom: fix TDM clocks, channel map and 32-bit
 routing for speakers

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sound/soc/qcom/qdsp6/q6routing.c | 3 +++
 sound/soc/qcom/sm8250.c          | 7 ++++++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/q6routing.c b/sound/soc/qcom/qdsp6/q6routing.c
index d076c99f1..b4554ba53 100644
--- a/sound/soc/qcom/qdsp6/q6routing.c
+++ b/sound/soc/qcom/qdsp6/q6routing.c
@@ -1159,6 +1159,9 @@ static int routing_hw_params(struct snd_soc_component *component,
 	case SNDRV_PCM_FORMAT_S24_LE:
 			session->bits_per_sample = 24;
 		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+			session->bits_per_sample = 32;
+		break;
 	default:
 		break;
 	}
diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index ae1264175..7cb50e9bf 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -4,6 +4,8 @@
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <sound/cs35l41.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
 #include <sound/pcm.h>
@@ -82,7 +84,7 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
 				struct snd_pcm_hw_params *params)
 {
-	static const unsigned int chmap[] = { 0, 1 };
+	static const unsigned int chmap[] = { 0, 4 };
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *dai;
@@ -131,6 +133,9 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 			snd_soc_dai_set_fmt(dai, SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_NB_NF |
 					    SND_SOC_DAIFMT_DSP_A);
 			snd_soc_dai_set_sysclk(dai, 0, TDM_BCLK_RATE, SND_SOC_CLOCK_IN);
+			/* The amp's PLL has to run from the TDM bit clock */
+			snd_soc_component_set_sysclk(dai->component, CS35L41_CLKID_SCLK, 0,
+						     TDM_BCLK_RATE, SND_SOC_CLOCK_IN);
 		}
 		break;
 	}
-- 
