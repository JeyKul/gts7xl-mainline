From 2d7aec130c572ca8e08b32e8555dee9f2f2cf15f Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Sat, 31 Oct 2026 14:47:48 +0100
Subject: [PATCH 3/9] arm64: dts: qcom: gts7xlwifi: boot directly from the
 Samsung bootloader

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
index c0730693e..747c5b1bb 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xlwifi.dts
@@ -11,12 +11,12 @@
 
 / {
 	model = "Samsung Galaxy Tab S7+ (Wi-Fi)";
-	compatible = "samsung,gts7xlwifi", "qcom,sm8250";
+	compatible = "samsung,gts7xlwifi", "qcom,kona", "qcom,sm8250";
 	chassis-type = "tablet";
 
-	/* The bootloader matches these against base DTBs before applying dtbo */
+	/* Values the bootloader accepts for a direct boot */
 	qcom,msm-id = <356 0x20001>;
-	qcom,board-id = <0 0>;
+	qcom,board-id = <8 6>;
 
 	/* Stock limits are 4.38V and 3.15A; stay conservative during bring-up */
 	battery: battery {
-- 
