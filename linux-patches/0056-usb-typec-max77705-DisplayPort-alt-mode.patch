+/* Raw firmware VDM replies, for alt mode bring-up */
+static int max77705_usbc_vdm_show(struct seq_file *s, void *unused)
+{
+	struct max77705_usbc *u = s->private;
+	static const struct { u8 sub; const char *name; } subs[] = {
+		{ 0x01, "id" }, { 0x02, "svids" }, { 0x03, "modes" },
+		{ 0x04, "enter" }, { 0x05, "exit" }, { 0x06, "attention" },
+		{ 0x10, "dp_status" }, { 0x11, "dp_config" },
+	};
+	u8 buf[MAX77705_VDM_RESP_LEN];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(subs); i++) {
+		u8 sub = subs[i].sub;
+
+		mutex_lock(&u->lock);
+		ret = u->halted ? -EBUSY :
+		      max77705_usbc_cmd(u, MAX77705_OP_GET_VDM_RESP, &sub, 1,
+					buf, sizeof(buf));
+		mutex_unlock(&u->lock);
+		if (ret)
+			seq_printf(s, "%s: error %d\n", subs[i].name, ret);
+		else
+			seq_printf(s, "%s: %*ph\n", subs[i].name, (int)sizeof(buf), buf);
+	}
+	return 0;
+}
