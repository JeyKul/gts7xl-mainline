 	ipa_hardware_deconfig(ipa);
 }
 
+#define IPA_UC_PAS_ID		27
+
+/*
+ * Some SoCs (SM8250) ship the IPA microcontroller as a separate image that
+ * Trust Zone loads after the GSI firmware.  Optional: a "qcom,uc-firmware-name"
+ * property and a second "memory-region".
+ */
+static int ipa_uc_firmware_load(struct device *dev)
+{
+	const struct firmware *fw;
+	struct resource res;
+	const char *path;
+	void *virt;
+	int ret;
+
+	if (of_property_read_string(dev->of_node, "qcom,uc-firmware-name", &path))
+		return 0;
+
+	ret = of_reserved_mem_region_to_resource(dev->of_node, 1, &res);
+	if (ret)
+		return ret;
+
+	ret = request_firmware(&fw, path, dev);
+	if (ret)
+		return ret;
+
+	virt = memremap(res.start, resource_size(&res), MEMREMAP_WC);
+	if (!virt) {
+		ret = -ENOMEM;
+		goto out_release;
+	}
+
+	ret = qcom_mdt_load(dev, fw, path, IPA_UC_PAS_ID, virt, res.start,
+			    resource_size(&res), NULL);
+	if (!ret)
+		ret = qcom_pas_auth_and_reset(IPA_UC_PAS_ID);
+	memunmap(virt);
+out_release:
+	release_firmware(fw);
+	dev_info(dev, "uC firmware \"%s\": %d\n", path, ret);
+
+	return ret;
+}
+
