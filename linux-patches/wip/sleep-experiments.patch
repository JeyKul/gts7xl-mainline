+/* gts7xl debug: display RSC state (drv 0xaf20000, wrapper 0xaf30000) */
+static struct clk *gts7xl_rsc_clk(int id)
+{
+	struct of_phandle_args args = { .args_count = 1, .args = { id } };
+	struct clk *c;
+
+	args.np = of_find_compatible_node(NULL, NULL, "qcom,sm8250-dispcc");
+	c = of_clk_get_from_provider(&args);
+	of_node_put(args.np);
+	return c;
+}
+
+static int gts7xl_rsc_show(struct seq_file *s, void *unused)
+{
+	static const u32 drv_regs[] = { 0x0, 0x4, 0x8, 0xc, 0x20, 0x24, 0x28, 0x2c, 0xd0,
+		0x400, 0x404, 0x408, 0x410, 0x414, 0xc04, 0xc08, 0xc0c, 0xc14, 0xc18, 0xc1c,
+		0xc20, 0xc24, 0xc28, 0xc2c, 0x1c00, 0x1c14 };
+	static const u32 wr_regs[] = { 0x0, 0x4, 0x8, 0xc, 0x10, 0x18, 0x1c, 0x20, 0x24,
+		0x40, 0x44, 0x48, 0x50 };
+	struct clk *ahb = gts7xl_rsc_clk(42), *vs = gts7xl_rsc_clk(43);
+	void __iomem *drv, *wr;
+	int i;
+
+	if (IS_ERR(ahb) || IS_ERR(vs))
+		return -ENODEV;
+	if (clk_prepare_enable(ahb) || clk_prepare_enable(vs))
+		return -EIO;
+	drv = ioremap(0x0af20000, 0x3c50);
+	wr = ioremap(0x0af30000, 0x3fd4);
+	for (i = 0; drv && i < ARRAY_SIZE(drv_regs); i++)
+		seq_printf(s, "drv+0x%04x %08x\n", drv_regs[i], readl(drv + drv_regs[i]));
+	for (i = 0; wr && i < ARRAY_SIZE(wr_regs); i++)
+		seq_printf(s, "wr +0x%04x %08x\n", wr_regs[i], readl(wr + wr_regs[i]));
+	if (drv)
+		iounmap(drv);
+	if (wr)
+		iounmap(wr);
+	clk_disable_unprepare(vs);
+	clk_disable_unprepare(ahb);
+	clk_put(vs);
+	clk_put(ahb);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(gts7xl_rsc);
+
+/*
+ * gts7xl test: drive the display RSC into mode 2 across system sleep, as the
+ * stock sde_rsc (v3) does once the display is off. Mainline leaves it in
+ * mode 0 (display active), which keeps the display DRV awake for AOSS.
+ */
+#define RSC_W(off, v)	writel(v, wr + (off))
+#define RSC_D(off, v)	writel(v, drv + (off))
+static bool gts7xl_rsc_inited, gts7xl_rsc_in_mode2;
+static bool gts7xl_rsc_enable;
+module_param_named(rsc_mode2, gts7xl_rsc_enable, bool, 0644);
+
+static void gts7xl_rsc_init(void __iomem *drv, void __iomem *wr)
+{
+	/* qtimer */
+	RSC_W(0x1fe0, 0xffffffff); RSC_W(0x1ff0, 0xffffffff);
+	RSC_W(0x1040, 1); RSC_W(0x1044, 1);
+	RSC_W(0x2020, 0xffffffff); RSC_W(0x2024, 0xffffffff);
+	RSC_W(0x3020, 0xffffffff); RSC_W(0x3024, 0xffffffff);
+	RSC_W(0x202c, 1); RSC_W(0x302c, 1);
+	/* wrapper */
+	RSC_W(0x008, 298299); RSC_W(0x00c, 20463); RSC_W(0x004, BIT(8)); RSC_W(0x044, 64);
+	/* sequencer memory: mode 0, 1, 2, tcs sleep and wake */
+	RSC_D(0x600, 0xff399ebe); RSC_D(0x604, 0x20209ebe); RSC_D(0x608, 0x20202020);
+	RSC_D(0x60c, 0xe0389ebe); RSC_D(0x610, 0x9ebeff39); RSC_D(0x614, 0x20202020);
+	RSC_D(0x618, 0xbdf9b9a0); RSC_D(0x61c, 0xa13899fe); RSC_D(0x620, 0xe0ac81e1);
+	RSC_D(0x624, 0x3982e2a2); RSC_D(0x628, 0x208cfd9d); RSC_D(0x62c, 0x20202020);
+	RSC_D(0x630, 0x20202020);
+	RSC_D(0x634, 0x01a6fcbc); RSC_D(0x638, 0x20209ce6); RSC_D(0x63c, 0x01a7fcbc);
+	RSC_D(0x640, 0x00209ce7);
+	RSC_D(0x410, 0x34); RSC_D(0x414, 0x3c);
+	RSC_D(0xc14, 0x0); RSC_D(0xc30, 0x0); RSC_D(0xc4c, 0xc); RSC_D(0xc68, 0x18);
+	/* solver */
+	RSC_D(0xc04, 0xffffffff); RSC_D(0xc08, 0xffffffff); RSC_D(0xc0c, 0xefffffff);
+	RSC_D(0x1000, 0); RSC_D(0x1004, 20463); RSC_D(0x1008, 320512); RSC_D(0x100c, 0xffffffff);
+	RSC_D(0xc20, 0x7);
+	RSC_D(0x1080, 0); RSC_D(0x1100, 1); RSC_D(0x110c, 1); RSC_D(0x1180, 2); RSC_D(0x118c, 2);
+	RSC_D(0xc18, 0); RSC_D(0xc00, 1); RSC_D(0xc1c, 0x01000010);
+	RSC_D(0xc34, 0x80000000); RSC_D(0xc38, 1); RSC_D(0xc40, 20);
+	RSC_D(0xc50, 0x80000000); RSC_D(0xc54, 2); RSC_D(0xc5c, 20);
+	RSC_D(0xc6c, 0x80000000); RSC_D(0xc70, 0); RSC_D(0xc78, 20);
+	/* pdc */
+	RSC_D(0x020, 0x4520); RSC_D(0x024, 0x4510); RSC_D(0x028, 0x4514); RSC_D(0x02c, 1);
+
+	/*
+	 * Sleep TCS (TCS0 at 0x1c00): zero every vote the display DRV may hold,
+	 * as stock's rpmh_flush on disp_rsc does (its bus votes are active only).
+	 */
+	{
+		static const u32 addr[] = {
+			0x30000, 0x30010, 0x30080, 0x300a0, 0x30020, 0x30070,	/* cx mx mmcx xo ebi ddr */
+			0x50000, 0x50004, 0x5009c, 0x500a0, 0x50094, 0x50098,	/* MC0 SH0 MM0-3 */
+			0x5007c, 0x50028, 0x50044, 0x50074,			/* ACV SN0 SN7 CN0 */
+		};
+		void __iomem *t = drv + 0x1c00;
+		int i;
+
+		for (i = 0; i < ARRAY_SIZE(addr); i++) {
+			writel(BIT(16) | 8, t + 0x30 + i * 0x14);
+			writel(addr[i], t + 0x34 + i * 0x14);
+			writel(addr[i] >= 0x50000 ? BIT(30) : 0, t + 0x38 + i * 0x14);
+		}
+		writel(0, t + 0x20);
+		writel(GENMASK(ARRAY_SIZE(addr) - 1, 0), t + 0x2c);
+	}
+	wmb();
+}
+
+int gts7xl_rsc_mode2(bool enter);
+int gts7xl_rsc_mode2(bool enter)
+{
+	struct clk *ahb = gts7xl_rsc_clk(42), *vs = gts7xl_rsc_clk(43), *ng = gts7xl_rsc_clk(35);
+	void __iomem *drv, *wr;
+	int i, try, ret = -EBUSY;
+	u32 v;
+
+	if (!gts7xl_rsc_enable || (!enter && !gts7xl_rsc_in_mode2))
+		return 0;
+	if (IS_ERR(ahb) || IS_ERR(vs) || IS_ERR(ng))
+		return -ENODEV;
+	clk_prepare_enable(ng);
+	clk_prepare_enable(ahb);
+	clk_prepare_enable(vs);
+	drv = ioremap(0x0af20000, 0x3c50);
+	wr = ioremap(0x0af30000, 0x3fd4);
+
+	if (enter) {
+		if (!gts7xl_rsc_inited) {
+			gts7xl_rsc_init(drv, wr);
+			gts7xl_rsc_inited = true;
+		}
+		/* stock CLK state (samsung,rsc_4_frame_idle panels): vsync off, solver off then double buffer */
+		v = readl(wr + 0x040) & ~(BIT(0) | BIT(1) | BIT(2));
+		RSC_W(0x040, v);
+		v = readl(wr + 0x004) & ~(BIT(0) | BIT(8));
+		RSC_W(0x004, v);
+		wmb();
+		RSC_W(0x004, readl(wr + 0x004) | BIT(8));
+		wmb();
+		for (try = 0; try < 3 && ret; try++) {
+			RSC_D(0xc20, 0x7);
+			/* sde_rsc_mode2_entry_trigger, CLK state */
+			RSC_W(0x2024, 0xffffffff);
+			RSC_W(0x2020, 0xffffffff);
+			RSC_W(0x000, readl(wr + 0x000) | BIT(3) | BIT(0));
+			RSC_W(0x040, readl(wr + 0x040) & ~BIT(3));
+			wmb();
+			RSC_W(0x004, BIT(0) | BIT(1));	/* force busy */
+			wmb();
+			RSC_W(0x004, BIT(0) | BIT(9));	/* then idle */
+			wmb();
+			for (i = 0; i < 500; i++) {
+				if (readl(wr + 0x024) & BIT(12)) {
+					ret = 0;
+					break;
+				}
+				udelay(100);
+			}
+			if (ret && readl(drv + 0x404) && readl(drv + 0xc2c) <= 1) {
+				/* sde_rsc_reset_mode_0_1: unstick the qtimers */
+				RSC_W(0x3024, 0xffffff); RSC_W(0x3020, 0xffffffff); wmb();
+				RSC_W(0x3024, 0); RSC_W(0x3020, 0); wmb();
+				RSC_W(0x2024, 0xffffff); RSC_W(0x2020, 0xffffffff); wmb();
+				RSC_W(0x2024, 0); RSC_W(0x2020, 0); wmb();
+			}
+		}
+		if (!ret) {
+			RSC_W(0x004, BIT(0) | BIT(8));
+			wmb();
+		}
+		gts7xl_rsc_in_mode2 = !ret;
+	} else {
+		RSC_W(0x004, readl(wr + 0x004) & ~(BIT(8) | BIT(0)));
+		RSC_W(0x3020, 0); RSC_W(0x3024, 0);
+		v = readl(wr + 0x000) & ~BIT(3);
+		RSC_W(0x000, v);
+		wmb();
+		for (i = 0; i < 500; i++) {
+			if (!(readl(wr + 0x024) & BIT(12))) {
+				ret = 0;
+				break;
+			}
+			udelay(50);
+		}
+		RSC_D(0xc20, 0x3);
+		v = readl(wr + 0x004) & ~(BIT(0) | BIT(8));
+		RSC_W(0x004, v);
+		wmb();
+		RSC_W(0x004, v | BIT(0) | BIT(8));
+		wmb();
+		gts7xl_rsc_in_mode2 = false;
+	}
+	pr_info("gts7xl rsc: mode2 %s: %d, pwr_ctrl 0x%x, solver mode %u\n",
+		enter ? "entry" : "exit", ret, readl(wr + 0x024), readl(drv + 0xc2c));
+	pr_info("gts7xl rsc: wr ctrl %x ovr %x ovr2 %x dbg %x | seq busy %x pc %x | solver st %x %x %x ovr %x | err %x amc %x\n",
+		readl(wr + 0x0), readl(wr + 0x4), readl(wr + 0x40), readl(wr + 0x10),
+		readl(drv + 0x404), readl(drv + 0x408), readl(drv + 0xc24), readl(drv + 0xc28),
+		readl(drv + 0xc2c), readl(drv + 0xc14), readl(drv + 0xd0), readl(drv + 0x1c00));
+	pr_info("gts7xl rsc: seq %x %x %x br %x %x | qtmr sel %x acr %x f0 %x/%x ctl %x f1 %x/%x ctl %x | modes %x tc %x\n",
+		readl(drv + 0x600), readl(drv + 0x618), readl(drv + 0x634), readl(drv + 0x410),
+		readl(drv + 0x414), readl(wr + 0x1fe0), readl(wr + 0x1040), readl(wr + 0x2024),
+		readl(wr + 0x2020), readl(wr + 0x202c), readl(wr + 0x3024), readl(wr + 0x3020),
+		readl(wr + 0x302c), readl(drv + 0xc20), readl(drv + 0xc00));
+
+	iounmap(wr);
+	iounmap(drv);
+	clk_disable_unprepare(vs);
+	clk_disable_unprepare(ahb);
+	clk_disable_unprepare(ng);
+	clk_put(vs);
+	clk_put(ahb);
+	clk_put(ng);
+	return ret;
+}
