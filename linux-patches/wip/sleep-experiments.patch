+/* gts7xl debug: send any QMP message written here */
+static ssize_t gts7xl_raw_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *pos)
+{
+	struct qmp *qmp = file->private_data;
+	char buf[QMP_MSG_LEN] = { 0 };
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	strim(buf);
+	ret = qmp_send(qmp, "%s", buf);
+	dev_info(qmp->dev, "raw qmp '%s': %d\n", buf, ret);
+	return ret ? ret : count;
+}
+
+static const struct file_operations gts7xl_raw_fops = {
+	.open = simple_open,
+	.write = gts7xl_raw_write,
+};
