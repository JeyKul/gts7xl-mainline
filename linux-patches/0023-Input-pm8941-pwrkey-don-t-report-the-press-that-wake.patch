From daf76f4b2d724aa2aee7131bba5f409ee1b54593 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 1 Nov 2026 21:17:24 +0100
Subject: [PATCH] Input: pm8941-pwrkey: don't report the press that wakes the
 system

---
 drivers/input/misc/pm8941-pwrkey.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/input/misc/pm8941-pwrkey.c b/drivers/input/misc/pm8941-pwrkey.c
index 53249d2c0..de480a84c 100644
--- a/drivers/input/misc/pm8941-pwrkey.c
+++ b/drivers/input/misc/pm8941-pwrkey.c
@@ -80,6 +80,8 @@ struct pm8941_pwrkey {
 	u32 code;
 	u32 sw_debounce_time_us;
 	ktime_t sw_debounce_end_time;
+	bool suspended;
+	ktime_t wake_ignore_end_time;
 	bool last_status;
 	const struct pm8941_data *data;
 };
@@ -167,6 +169,13 @@ static irqreturn_t pm8941_pwrkey_irq(int irq, void *_data)
 
 	sts &= pwrkey->data->status_bit;
 
+	/* The press that wakes the system must not reach userspace as a new press */
+	if (READ_ONCE(pwrkey->suspended) ||
+	    ktime_before(ktime_get(), pwrkey->wake_ignore_end_time)) {
+		pwrkey->last_status = sts;
+		return IRQ_HANDLED;
+	}
+
 	if (pwrkey->sw_debounce_time_us && !sts)
 		pwrkey->sw_debounce_end_time = ktime_add_us(ktime_get(),
 						pwrkey->sw_debounce_time_us);
@@ -224,6 +233,8 @@ static int pm8941_pwrkey_suspend(struct device *dev)
 {
 	struct pm8941_pwrkey *pwrkey = dev_get_drvdata(dev);
 
+	WRITE_ONCE(pwrkey->suspended, true);
+
 	if (device_may_wakeup(dev))
 		enable_irq_wake(pwrkey->irq);
 
@@ -237,6 +248,9 @@ static int pm8941_pwrkey_resume(struct device *dev)
 	if (device_may_wakeup(dev))
 		disable_irq_wake(pwrkey->irq);
 
+	pwrkey->wake_ignore_end_time = ktime_add_ms(ktime_get(), 1000);
+	WRITE_ONCE(pwrkey->suspended, false);
+
 	return 0;
 }
 
-- 
2.56.0

