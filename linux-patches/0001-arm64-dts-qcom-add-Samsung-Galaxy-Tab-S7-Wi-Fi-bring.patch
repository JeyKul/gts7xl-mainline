diff --git a/drivers/input/keyboard/samsung-stm32-pogo.c b/drivers/input/keyboard/samsung-stm32-pogo.c
new file mode 100644
index 000000000..9189b86e8
--- /dev/null
+++ b/drivers/input/keyboard/samsung-stm32-pogo.c
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Keyboard driver for Samsung Book Cover keyboards attached through the pogo
+ * connector. An STM32 MCU on the tablet exposes key events over I2C.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/matrix_keypad.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define POGO_ROW_SHIFT		5
+#define POGO_MAX_EVENT_SIZE	100
+#define POGO_HDR_SIZE		3
+#define POGO_I2C_RETRIES	3
+
+#define POGO_ID_MCU		1
+#define POGO_ID_TOUCHPAD	2
+#define POGO_ID_KEYPAD		3
+#define POGO_ID_HALL		4
+
+#define POGO_CMD_GET_MODE	0x01
+#define POGO_CMD_CHECK_VERSION	0x02
+#define POGO_CMD_CHECK_CRC	0x03
+#define POGO_CMD_TC_VERSION	0x18
+#define POGO_CMD_TC_CRC		0x19
+#define POGO_CMD_TC_RESOLUTION	0x1a
+
+#define POGO_KEY_PRESS		BIT(0)
+#define POGO_KEY_COL(v)		(((v) >> 1) & 0x1f)
+#define POGO_KEY_ROW(v)		(((v) >> 6) & 0x7)
+
+static bool pogo_quiet;
+module_param(pogo_quiet, bool, 0644);
+MODULE_PARM_DESC(pogo_quiet, "Power the MCU but leave its interrupt off, for bring-up");
+
+struct pogo_kbd {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct regulator *vdd;
+	struct gpio_desc *conn;
+	struct delayed_work conn_work;
+	unsigned int rows;
+	unsigned int cols;
+	bool connected;
+	bool irq_on;
+	unsigned short keycodes[8 << POGO_ROW_SHIFT];
+};
+
+static void pogo_release_keys(struct pogo_kbd *kbd)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(kbd->keycodes); i++)
+		if (kbd->keycodes[i])
+			input_report_key(kbd->input, kbd->keycodes[i], 0);
+	input_sync(kbd->input);
+}
+
+static void pogo_report_keys(struct pogo_kbd *kbd, const u8 *data, unsigned int len)
+{
+	unsigned int i;
+
+	for (i = 0; i + 2 <= len; i += 2) {
+		u16 ev = get_unaligned_le16(data + i);
+		unsigned int row = POGO_KEY_ROW(ev);
+		unsigned int col = POGO_KEY_COL(ev);
+		unsigned int code;
+
+		if (row >= kbd->rows || col >= kbd->cols)
+			continue;
+
+		code = MATRIX_SCAN_CODE(row, col, POGO_ROW_SHIFT);
+		input_event(kbd->input, EV_MSC, MSC_SCAN, code);
+		input_report_key(kbd->input, kbd->keycodes[code], ev & POGO_KEY_PRESS);
+		input_sync(kbd->input);
+	}
+}
+
+static int pogo_xfer(struct i2c_client *client, const u8 *tx, int txlen, u8 *rx, int rxlen)
+{
+	int retry, ret = 0;
+
+	for (retry = 0; retry < POGO_I2C_RETRIES; retry++) {
+		ret = tx ? i2c_master_send(client, tx, txlen) : i2c_master_recv(client, rx, rxlen);
+		if (ret == (tx ? txlen : rxlen))
+			return 0;
+		msleep(10);
+	}
+
+	return ret < 0 ? ret : -EIO;
+}
+
+static int pogo_reg_read(struct i2c_client *client, u8 id, u8 reg, u8 *val, unsigned int len)
+{
+	u8 req[POGO_HDR_SIZE] = { POGO_HDR_SIZE + 1, 0, id };
+	u8 hdr[POGO_HDR_SIZE];
+	unsigned int size;
+	int ret;
+
+	ret = pogo_xfer(client, req, sizeof(req), NULL, 0);
+	if (!ret)
+		ret = pogo_xfer(client, &reg, 1, NULL, 0);
+	if (!ret)
+		ret = pogo_xfer(client, NULL, 0, hdr, sizeof(hdr));
+	if (ret)
+		return ret;
+
+	size = get_unaligned_le16(hdr);
+	if (size <= POGO_HDR_SIZE || size - POGO_HDR_SIZE > len)
+		return -EIO;
+
+	return pogo_xfer(client, NULL, 0, val, size - POGO_HDR_SIZE);
+}
+
+/* The MCU expects these queries after it announces itself with an empty frame */
+static void pogo_handshake(struct pogo_kbd *kbd)
+{
+	static const struct {
+		u8 id;
+		u8 reg;
+		u8 len;
+		const char *name;
+	} steps[] = {
+		{ POGO_ID_MCU, POGO_CMD_CHECK_VERSION, 4, "version" },
+		{ POGO_ID_MCU, POGO_CMD_GET_MODE, 1, "mode" },
+		{ POGO_ID_MCU, POGO_CMD_CHECK_CRC, 4, "crc" },
+		{ POGO_ID_TOUCHPAD, POGO_CMD_TC_VERSION, 6, "tc version" },
+		{ POGO_ID_TOUCHPAD, POGO_CMD_TC_CRC, 2, "tc crc" },
+		{ POGO_ID_TOUCHPAD, POGO_CMD_TC_RESOLUTION, 4, "tc resolution" },
+	};
+	struct device *dev = &kbd->client->dev;
+	u8 val[6];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		memset(val, 0, sizeof(val));
+		ret = pogo_reg_read(kbd->client, steps[i].id, steps[i].reg, val, steps[i].len);
+		if (ret)
+			dev_err(dev, "%s read failed: %d\n", steps[i].name, ret);
+		else
+			dev_info(dev, "%s: %*ph\n", steps[i].name, steps[i].len, val);
+		if (steps[i].reg == POGO_CMD_GET_MODE)
+			msleep(200);
+	}
+}
+
+static irqreturn_t pogo_irq(int irq, void *dev_id)
+{
+	static const u8 req[POGO_HDR_SIZE] = { POGO_HDR_SIZE, 0, POGO_ID_MCU };
+	struct pogo_kbd *kbd = dev_id;
+	struct i2c_client *client = kbd->client;
+	u8 hdr[POGO_HDR_SIZE];
+	u8 data[POGO_MAX_EVENT_SIZE];
+	unsigned int size;
+	int ret;
+
+	ret = pogo_xfer(client, req, sizeof(req), NULL, 0);
+	if (ret) {
+		dev_err_ratelimited(&client->dev, "header write failed: %d\n", ret);
+		goto err;
+	}
+
+	ret = pogo_xfer(client, NULL, 0, hdr, sizeof(hdr));
+	if (ret) {
+		dev_err_ratelimited(&client->dev, "header read failed: %d\n", ret);
+		goto err;
+	}
+
+	size = get_unaligned_le16(hdr);
+	dev_info_ratelimited(&client->dev, "frame size=%u id=%u\n", size, hdr[2]);
+	/* The MCU sends an empty frame after it (re)starts */
+	if (size <= POGO_HDR_SIZE || size - POGO_HDR_SIZE > sizeof(data)) {
+		pogo_handshake(kbd);
+		return IRQ_HANDLED;
+	}
+	size -= POGO_HDR_SIZE;
+
+	ret = pogo_xfer(client, NULL, 0, data, size);
+	if (ret) {
+		dev_err_ratelimited(&client->dev, "payload read failed: %d\n", ret);
+		goto err;
+	}
+
+	/* Noise from the connector settling */
+	if (size >= 3 && data[0] == 0x03 && data[1] == 0x00 && data[2] == 0x05)
+		return IRQ_HANDLED;
+
+	switch (hdr[2]) {
+	case POGO_ID_KEYPAD:
+		pogo_report_keys(kbd, data, size);
+		break;
+	case POGO_ID_HALL:
+		pogo_release_keys(kbd);
+		break;
+	default:
+		break;
+	}
+
+	return IRQ_HANDLED;
+
+err:
+	pogo_release_keys(kbd);
+	return IRQ_HANDLED;
+}
+
+static void pogo_set_connected(struct pogo_kbd *kbd, bool connected)
+{
+	int ret;
+
+	if (connected == kbd->connected)
+		return;
+
+	if (connected) {
+		ret = regulator_enable(kbd->vdd);
+		if (ret) {
+			dev_err(&kbd->client->dev, "failed to enable vdd: %d\n", ret);
+			return;
+		}
+		msleep(50);
+		if (!pogo_quiet)
+			enable_irq(kbd->client->irq);
+		kbd->irq_on = !pogo_quiet;
+	} else {
+		if (kbd->irq_on)
+			disable_irq(kbd->client->irq);
+		pogo_release_keys(kbd);
+		regulator_disable(kbd->vdd);
+	}
+
+	kbd->connected = connected;
+	dev_info(&kbd->client->dev, "keyboard %s\n", connected ? "attached" : "detached");
+}
+
+static void pogo_conn_work(struct work_struct *work)
+{
+	struct pogo_kbd *kbd = container_of(work, struct pogo_kbd, conn_work.work);
+
+	pogo_set_connected(kbd, gpiod_get_value_cansleep(kbd->conn));
+}
+
+static irqreturn_t pogo_conn_irq(int irq, void *dev_id)
+{
+	struct pogo_kbd *kbd = dev_id;
+
+	mod_delayed_work(system_wq, &kbd->conn_work, msecs_to_jiffies(250));
+	return IRQ_HANDLED;
+}
+
+static void pogo_shutdown_action(void *data)
+{
+	struct pogo_kbd *kbd = data;
+
+	cancel_delayed_work_sync(&kbd->conn_work);
+	pogo_set_connected(kbd, false);
+}
+
+static int pogo_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gpio_desc *reset, *boot;
+	struct pogo_kbd *kbd;
+	int conn_irq;
+	int ret;
+
+	kbd = devm_kzalloc(dev, sizeof(*kbd), GFP_KERNEL);
+	if (!kbd)
+		return -ENOMEM;
+
+	kbd->client = client;
+	INIT_DELAYED_WORK(&kbd->conn_work, pogo_conn_work);
+
+	kbd->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(kbd->vdd))
+		return dev_err_probe(dev, PTR_ERR(kbd->vdd), "failed to get vdd\n");
+
+	kbd->conn = devm_gpiod_get(dev, "conn", GPIOD_IN);
+	if (IS_ERR(kbd->conn))
+		return dev_err_probe(dev, PTR_ERR(kbd->conn), "failed to get conn gpio\n");
+
+	reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset), "failed to get reset gpio\n");
+
+	boot = devm_gpiod_get(dev, "boot", GPIOD_OUT_LOW);
+	if (IS_ERR(boot))
+		return dev_err_probe(dev, PTR_ERR(boot), "failed to get boot gpio\n");
+
+	ret = of_property_read_u32(dev->of_node, "keypad,num-rows", &kbd->rows);
+	if (ret)
+		return ret;
+	ret = of_property_read_u32(dev->of_node, "keypad,num-columns", &kbd->cols);
+	if (ret)
+		return ret;
+	if (kbd->rows > 8 || kbd->cols > BIT(POGO_ROW_SHIFT))
+		return -EINVAL;
+
+	kbd->input = devm_input_allocate_device(dev);
+	if (!kbd->input)
+		return -ENOMEM;
+
+	kbd->input->name = "Samsung Book Cover Keyboard";
+	kbd->input->id.bustype = BUS_I2C;
+	input_set_capability(kbd->input, EV_MSC, MSC_SCAN);
+
+	ret = matrix_keypad_build_keymap(NULL, NULL, kbd->rows, BIT(POGO_ROW_SHIFT),
+					 kbd->keycodes, kbd->input);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to build keymap\n");
+
+	ret = input_register_device(kbd->input);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, pogo_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"pogo-keyboard", kbd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	ret = devm_add_action_or_reset(dev, pogo_shutdown_action, kbd);
+	if (ret)
+		return ret;
+
+	conn_irq = gpiod_to_irq(kbd->conn);
+	if (conn_irq < 0)
+		return dev_err_probe(dev, conn_irq, "failed to get conn irq\n");
+
+	ret = devm_request_threaded_irq(dev, conn_irq, NULL, pogo_conn_irq,
+					IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+					"pogo-conn", kbd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request conn irq\n");
+
+	schedule_delayed_work(&kbd->conn_work, 0);
+	return 0;
+}
+
+static const struct of_device_id pogo_of_match[] = {
+	{ .compatible = "samsung,stm32-pogo-keyboard" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pogo_of_match);
+
+static struct i2c_driver pogo_driver = {
+	.driver = {
+		.name = "samsung-stm32-pogo",
+		.of_match_table = pogo_of_match,
+	},
+	.probe = pogo_probe,
+};
+module_i2c_driver(pogo_driver);
+
+MODULE_DESCRIPTION("Samsung Book Cover pogo keyboard driver");
+MODULE_LICENSE("GPL");
