+
+&tlmm {
+	/* gpio43 is the pogo connection detect line on this board */
+	gpio-reserved-ranges = <20 4>, <40 3>;
+
+	/* Bring-up test: match the stock state of these power enables */
+	spen-3v3-hog {
+		gpio-hog;
+		gpios = <93 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "vdd_spen_3p3";
+	};
+
+	grip-ldo-hog {
+		gpio-hog;
+		gpios = <64 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "grip_ldo";
+	};
+
+	pogo_default: pogo-default-state {
+		int-pins {
+			pins = "gpio31";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
