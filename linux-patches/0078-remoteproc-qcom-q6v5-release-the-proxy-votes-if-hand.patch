From 452048880a6876a2003a0838bbb4a0c7c8256c27 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sun, 8 Nov 2026 22:26:46 +0100
Subject: [PATCH 78/78] remoteproc: qcom: q6v5: release the proxy votes if
 handover never comes

Until handover, the proxy votes stay: CXO, proxy power domains and
regulators, and a maximum interconnect vote. Downstream drops them after
qcom,proxy-timeout-ms (10 s) whatever the firmware does; do the same,
counted from the ready interrupt, so a missing handover can't keep the
SoC out of deep sleep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/remoteproc/qcom_q6v5.c | 32 ++++++++++++++++++++++++++++++++
 drivers/remoteproc/qcom_q6v5.h |  3 +++
 2 files changed, 35 insertions(+)

diff --git a/drivers/remoteproc/qcom_q6v5.c b/drivers/remoteproc/qcom_q6v5.c
index fe148b4b3..58e3dda71 100644
--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -112,6 +112,7 @@ EXPORT_SYMBOL_GPL(qcom_q6v5_prepare);
  */
 int qcom_q6v5_unprepare(struct qcom_q6v5 *q6v5)
 {
+	cancel_delayed_work_sync(&q6v5->handover_timeout);
 	q6v5_handover_irq_disable(q6v5, true);
 
 	q6v5_load_state_toggle(q6v5, false);
@@ -168,11 +169,40 @@ static irqreturn_t q6v5_fatal_interrupt(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+/*
+ * Some firmware (Samsung's SM8250 ADSP, CDSP and SLPI at least) never raises
+ * the handover interrupt. The proxy votes then stay forever: CXO, the proxy
+ * power domains and regulators, and a maximum interconnect vote, so the SoC
+ * never reaches AOSS sleep. Downstream releases them after
+ * qcom,proxy-timeout-ms (10 s) whatever the firmware says; do the same.
+ */
+#define Q6V5_HANDOVER_TIMEOUT_MS	10000
+
+static void q6v5_handover_timeout_work(struct work_struct *work)
+{
+	struct qcom_q6v5 *q6v5 = container_of(to_delayed_work(work),
+					      struct qcom_q6v5, handover_timeout);
+
+	/* Waits for a handover interrupt that is still running */
+	q6v5_handover_irq_disable(q6v5, true);
+	if (q6v5->handover_issued)
+		return;
+
+	dev_info(q6v5->dev, "no handover from the firmware, releasing proxy votes\n");
+	q6v5->handover_issued = true;
+	if (q6v5->handover)
+		q6v5->handover(q6v5);
+	icc_set_bw(q6v5->path, 0, 0);
+}
+
 static irqreturn_t q6v5_ready_interrupt(int irq, void *data)
 {
 	struct qcom_q6v5 *q6v5 = data;
 
 	complete(&q6v5->start_done);
+	if (!q6v5->handover_issued)
+		schedule_delayed_work(&q6v5->handover_timeout,
+				      msecs_to_jiffies(Q6V5_HANDOVER_TIMEOUT_MS));
 
 	return IRQ_HANDLED;
 }
@@ -290,6 +320,7 @@ int qcom_q6v5_init(struct qcom_q6v5 *q6v5, struct platform_device *pdev,
 	q6v5->handover = handover;
 
 	spin_lock_init(&q6v5->handover_lock);
+	INIT_DELAYED_WORK(&q6v5->handover_timeout, q6v5_handover_timeout_work);
 
 	init_completion(&q6v5->start_done);
 	init_completion(&q6v5->stop_done);
@@ -386,6 +417,7 @@ EXPORT_SYMBOL_GPL(qcom_q6v5_init);
  */
 void qcom_q6v5_deinit(struct qcom_q6v5 *q6v5)
 {
+	cancel_delayed_work_sync(&q6v5->handover_timeout);
 	qmp_put(q6v5->qmp);
 }
 EXPORT_SYMBOL_GPL(qcom_q6v5_deinit);
diff --git a/drivers/remoteproc/qcom_q6v5.h b/drivers/remoteproc/qcom_q6v5.h
index 8991ff090..3fef5871d 100644
--- a/drivers/remoteproc/qcom_q6v5.h
+++ b/drivers/remoteproc/qcom_q6v5.h
@@ -5,6 +5,7 @@
 
 #include <linux/kernel.h>
 #include <linux/completion.h>
+#include <linux/workqueue.h>
 #include <linux/spinlock.h>
 #include <linux/soc/qcom/qcom_aoss.h>
 
@@ -34,6 +35,8 @@ struct qcom_q6v5 {
 	spinlock_t handover_lock;
 	bool handover_irq_enabled;
 	bool handover_issued;
+	/* Releases the proxy votes if the firmware never signals handover */
+	struct delayed_work handover_timeout;
 
 	struct completion start_done;
 	struct completion stop_done;
-- 
2.56.0

