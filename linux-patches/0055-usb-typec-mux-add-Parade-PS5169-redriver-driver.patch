From 011203e01e3077d447cfe100b044ef38d2c8bd62 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Sat, 7 Nov 2026 19:54:10 +0100
Subject: [PATCH 55/57] usb: typec: mux: add Parade PS5169 redriver driver

The PS5169 is a USB-C 10 Gbps linear redriver and DP/USB3 crossbar.
Register 0x40 selects USB3, DP+USB3 (2 lanes) or DP (4 lanes) per plug
side; the init sequence and the tuning follow the Samsung Galaxy Tab S7+
kernel. It sits between the QMP PHY and the connector as a typec switch
and mux and a DRM aux bridge, like nb7vpq904m.

Only DP states are forwarded to the PHY: switching it to USB3-only on
detach and back to USB3+DP on attach left DP link training failing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/typec/mux/Kconfig  |  10 ++
 drivers/usb/typec/mux/Makefile |   1 +
 drivers/usb/typec/mux/ps5169.c | 267 +++++++++++++++++++++++++++++++++
 3 files changed, 278 insertions(+)
 create mode 100644 drivers/usb/typec/mux/ps5169.c

diff --git a/drivers/usb/typec/mux/Kconfig b/drivers/usb/typec/mux/Kconfig
index 6dd8f961b..ed9172522 100644
--- a/drivers/usb/typec/mux/Kconfig
+++ b/drivers/usb/typec/mux/Kconfig
@@ -56,6 +56,16 @@ config TYPEC_MUX_NB7VPQ904M
 	  Say Y or M if your system has a On Semiconductor NB7VPQ904M Type-C
 	  redriver chip found on some devices with a Type-C port.
 
+config TYPEC_MUX_PS5169
+	tristate "Parade PS5169 Type-C redriver driver"
+	depends on I2C
+	depends on DRM || DRM=n
+	select DRM_AUX_BRIDGE if DRM_BRIDGE && OF
+	select REGMAP_I2C
+	help
+	  Say Y or M if your system has a Parade PS5169 USB-C redriver and
+	  DP/USB3 crossbar, as on the Samsung Galaxy Tab S7+.
+
 config TYPEC_MUX_PS883X
 	tristate "Parade PS883x Type-C retimer driver"
 	depends on I2C
diff --git a/drivers/usb/typec/mux/Makefile b/drivers/usb/typec/mux/Makefile
index b4f599eb5..c775bfa12 100644
--- a/drivers/usb/typec/mux/Makefile
+++ b/drivers/usb/typec/mux/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_TYPEC_MUX_PI3USB30532)	+= pi3usb30532.o
 obj-$(CONFIG_TYPEC_MUX_INTEL_PMC)	+= intel_pmc_mux.o
 obj-$(CONFIG_TYPEC_MUX_IT5205)		+= it5205.o
 obj-$(CONFIG_TYPEC_MUX_NB7VPQ904M)	+= nb7vpq904m.o
+obj-$(CONFIG_TYPEC_MUX_PS5169)		+= ps5169.o
 obj-$(CONFIG_TYPEC_MUX_PS883X)		+= ps883x.o
 obj-$(CONFIG_TYPEC_MUX_PTN36502)	+= ptn36502.o
 obj-$(CONFIG_TYPEC_MUX_TUSB1046)	+= tusb1046.o
diff --git a/drivers/usb/typec/mux/ps5169.c b/drivers/usb/typec/mux/ps5169.c
new file mode 100644
index 000000000..fbdd81b70
--- /dev/null
+++ b/drivers/usb/typec/mux/ps5169.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Parade PS5169 USB-C 10 Gbps linear redriver and DP/USB3 crossbar.
+ *
+ * Register values follow the Samsung Galaxy Tab S7+ (SM-T970) kernel,
+ * drivers/redriver/ps5169.c: one init sequence at probe, then register
+ * 0x40 selects USB3, DP+USB3 (2 lanes) or DP (4 lanes) per plug side.
+ */
+
+#include <drm/bridge/aux-bridge.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regmap.h>
+#include <linux/usb/typec_dp.h>
+#include <linux/usb/typec_mux.h>
+
+#define PS5169_CONFIG		0x40
+#define PS5169_AUX_CTRL		0x9d
+#define PS5169_DP_EQ_A0		0xa0
+#define PS5169_DP_EQ_A1		0xa1
+#define PS5169_REV_L		0xae
+#define PS5169_REV_H		0xaf
+#define PS5169_ID_L		0xac
+#define PS5169_ID_H		0xad
+
+#define PS5169_CHIP_ID		0x6987
+
+/* PS5169_CONFIG: bit 4 set for the rear (CC2) side */
+#define PS5169_CFG_CLEAR	0x80
+#define PS5169_CFG_USB3		0xc0
+#define PS5169_CFG_DP4		0xa0
+#define PS5169_CFG_DP2_USB3	0xe0
+#define PS5169_CFG_REAR		BIT(4)
+
+/* WORK_MODE init, after the 0x9d pulse; 0x52 is this tablet's tuning */
+static const struct reg_sequence ps5169_init[] = {
+	{ PS5169_CONFIG, PS5169_CFG_CLEAR },
+	{ PS5169_DP_EQ_A0, 0x02 },
+	{ 0x8d, 0x01 }, { 0x90, 0x01 }, { 0x51, 0x40 }, { 0x50, 0x20 },
+	{ 0x54, 0x00 }, { 0x5d, 0x44 }, { 0x55, 0x00 }, { 0x56, 0x00 },
+	{ 0x57, 0x00 }, { 0x58, 0x00 }, { 0x59, 0x00 }, { 0x5a, 0x00 },
+	{ 0x5b, 0x00 }, { 0x5f, 0x00 }, { 0x60, 0x00 }, { 0x61, 0x03 },
+	{ 0x65, 0x40 }, { 0x66, 0x00 }, { 0x67, 0x03 },
+	{ 0x52, 0x30 }, { 0x5e, 0x06 },
+};
+
+struct ps5169 {
+	struct i2c_client *client;
+	struct regmap *regmap;
+	struct typec_switch_dev *sw;
+	struct typec_mux_dev *mux;
+	struct typec_switch *typec_switch;	/* downstream: the QMP PHY */
+	struct typec_mux *typec_mux;
+	struct mutex lock;	/* orientation, svid, mode */
+	enum typec_orientation orientation;
+	unsigned long mode;
+	unsigned int svid;
+};
+
+static int ps5169_apply(struct ps5169 *ps)
+{
+	bool rear = ps->orientation == TYPEC_ORIENTATION_REVERSE;
+	u8 cfg, a0 = 0x00, a1 = 0x04;
+
+	if (ps->orientation == TYPEC_ORIENTATION_NONE ||
+	    ps->mode == TYPEC_STATE_SAFE) {
+		cfg = PS5169_CFG_CLEAR;
+		a0 = 0x02;
+		a1 = 0x00;
+	} else if (ps->svid == USB_TYPEC_DP_SID) {
+		switch (ps->mode) {
+		case TYPEC_DP_STATE_C:
+		case TYPEC_DP_STATE_E:
+			cfg = PS5169_CFG_DP4;
+			break;
+		default:
+			cfg = PS5169_CFG_DP2_USB3;
+			break;
+		}
+	} else {
+		cfg = PS5169_CFG_USB3;
+		a0 = 0x02;
+		a1 = 0x00;
+	}
+
+	if (cfg != PS5169_CFG_CLEAR && rear)
+		cfg |= PS5169_CFG_REAR;
+
+	dev_dbg(&ps->client->dev, "config 0x%02x\n", cfg);
+
+	return regmap_multi_reg_write(ps->regmap, (const struct reg_sequence[]) {
+		{ PS5169_CONFIG, cfg },
+		{ PS5169_DP_EQ_A0, a0 },
+		{ PS5169_DP_EQ_A1, a1 },
+	}, 3);
+}
+
+static int ps5169_sw_set(struct typec_switch_dev *sw,
+			 enum typec_orientation orientation)
+{
+	struct ps5169 *ps = typec_switch_get_drvdata(sw);
+	int ret;
+
+	ret = typec_switch_set(ps->typec_switch, orientation);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&ps->lock);
+	if (ps->orientation == orientation)
+		return 0;
+	ps->orientation = orientation;
+	return ps5169_apply(ps);
+}
+
+static int ps5169_mux_set(struct typec_mux_dev *mux,
+			  struct typec_mux_state *state)
+{
+	struct ps5169 *ps = typec_mux_get_drvdata(mux);
+	int ret;
+
+	/*
+	 * The PHY only follows DP states. Dropping it to USB3-only on detach
+	 * and back to USB3+DP on the next attach left DP link training
+	 * failing (clock recovery) until reboot; USB3 does not use it yet.
+	 */
+	if (state->alt && state->alt->svid == USB_TYPEC_DP_SID) {
+		ret = typec_mux_set(ps->typec_mux, state);
+		if (ret)
+			return ret;
+	}
+
+	guard(mutex)(&ps->lock);
+	ps->mode = state->mode;
+	ps->svid = state->alt ? state->alt->svid : 0;
+	return ps5169_apply(ps);
+}
+
+static const struct regmap_config ps5169_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+};
+
+static int ps5169_probe(struct i2c_client *client)
+{
+	struct typec_switch_desc sw_desc = { };
+	struct typec_mux_desc mux_desc = { };
+	struct device *dev = &client->dev;
+	unsigned int id_l, id_h, rev_l, rev_h;
+	struct ps5169 *ps;
+	int ret;
+
+	ps = devm_kzalloc(dev, sizeof(*ps), GFP_KERNEL);
+	if (!ps)
+		return -ENOMEM;
+
+	ps->client = client;
+	mutex_init(&ps->lock);
+	ps->orientation = TYPEC_ORIENTATION_NONE;
+	ps->mode = TYPEC_STATE_SAFE;
+
+	ps->regmap = devm_regmap_init_i2c(client, &ps5169_regmap);
+	if (IS_ERR(ps->regmap))
+		return dev_err_probe(dev, PTR_ERR(ps->regmap), "regmap\n");
+
+	ret = regmap_read(ps->regmap, PS5169_ID_L, &id_l);
+	ret = ret ?: regmap_read(ps->regmap, PS5169_ID_H, &id_h);
+	ret = ret ?: regmap_read(ps->regmap, PS5169_REV_L, &rev_l);
+	ret = ret ?: regmap_read(ps->regmap, PS5169_REV_H, &rev_h);
+	if (ret)
+		return dev_err_probe(dev, ret, "not responding\n");
+	if ((id_h << 8 | id_l) != PS5169_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV, "chip id 0x%02x%02x\n", id_h, id_l);
+
+	regmap_write(ps->regmap, PS5169_AUX_CTRL, 0x80);
+	usleep_range(10000, 10100);
+	regmap_write(ps->regmap, PS5169_AUX_CTRL, 0x00);
+	ret = regmap_multi_reg_write(ps->regmap, ps5169_init, ARRAY_SIZE(ps5169_init));
+	if (ret)
+		return dev_err_probe(dev, ret, "init\n");
+
+	ps->typec_switch = fwnode_typec_switch_get(dev_fwnode(dev));
+	if (IS_ERR(ps->typec_switch))
+		return dev_err_probe(dev, PTR_ERR(ps->typec_switch),
+				     "downstream orientation switch\n");
+
+	ps->typec_mux = fwnode_typec_mux_get(dev_fwnode(dev));
+	if (IS_ERR(ps->typec_mux)) {
+		ret = dev_err_probe(dev, PTR_ERR(ps->typec_mux),
+				    "downstream mode switch\n");
+		goto err_switch_put;
+	}
+
+	ret = drm_aux_bridge_register(dev);
+	if (ret)
+		goto err_mux_put;
+
+	sw_desc.drvdata = ps;
+	sw_desc.fwnode = dev_fwnode(dev);
+	sw_desc.set = ps5169_sw_set;
+	ps->sw = typec_switch_register(dev, &sw_desc);
+	if (IS_ERR(ps->sw)) {
+		ret = dev_err_probe(dev, PTR_ERR(ps->sw), "switch register\n");
+		goto err_mux_put;
+	}
+
+	mux_desc.drvdata = ps;
+	mux_desc.fwnode = dev_fwnode(dev);
+	mux_desc.set = ps5169_mux_set;
+	ps->mux = typec_mux_register(dev, &mux_desc);
+	if (IS_ERR(ps->mux)) {
+		ret = dev_err_probe(dev, PTR_ERR(ps->mux), "mux register\n");
+		goto err_switch_unregister;
+	}
+
+	i2c_set_clientdata(client, ps);
+	dev_info(dev, "PS5169 rev 0x%02x%02x\n", rev_h, rev_l);
+	return 0;
+
+err_switch_unregister:
+	typec_switch_unregister(ps->sw);
+err_mux_put:
+	typec_mux_put(ps->typec_mux);
+err_switch_put:
+	typec_switch_put(ps->typec_switch);
+	return ret;
+}
+
+static void ps5169_remove(struct i2c_client *client)
+{
+	struct ps5169 *ps = i2c_get_clientdata(client);
+
+	regmap_write(ps->regmap, PS5169_CONFIG, PS5169_CFG_CLEAR);
+	typec_mux_unregister(ps->mux);
+	typec_switch_unregister(ps->sw);
+	typec_mux_put(ps->typec_mux);
+	typec_switch_put(ps->typec_switch);
+}
+
+static const struct i2c_device_id ps5169_table[] = {
+	{ "ps5169" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ps5169_table);
+
+static const struct of_device_id ps5169_of_table[] = {
+	{ .compatible = "parade,ps5169" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ps5169_of_table);
+
+static struct i2c_driver ps5169_driver = {
+	.driver = {
+		.name = "ps5169",
+		.of_match_table = ps5169_of_table,
+	},
+	.probe = ps5169_probe,
+	.remove = ps5169_remove,
+	.id_table = ps5169_table,
+};
+module_i2c_driver(ps5169_driver);
+
+MODULE_DESCRIPTION("Parade PS5169 USB-C redriver driver");
+MODULE_LICENSE("GPL");
-- 
2.56.0

