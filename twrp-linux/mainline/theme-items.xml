				<listitem name="Wi-Fi">
					<actions>
						<action function="cmd">/system/bin/gts7xl-wifi scan</action>
						<action function="set">tw_gts7xl_wifi_dir=/tmp/gts7xl-wifi/nets</action>
						<action function="set">tw_gts7xl_ssid=</action>
						<action function="page">gts7xl_wifi</action>
					</actions>
				</listitem>
				<listitem name="Open Linux data">
					<actions>
						<action function="set">tw_gts7xl_lpw=</action>
						<action function="set">tw_gts7xl_hint=Password of the Linux install</action>
						<action function="cmd">touch /tmp/gts7xl-locked</action>
						<action function="page">gts7xl_linux_pw</action>
					</actions>
				</listitem>
				<listitem name="Lock Linux data">
					<action function="cmd">/system/bin/linux-data off</action>
				</listitem>
				<listitem name="Doom (needs Linux data)">
					<action function="cmd">/system/bin/gts7xl-doom</action>
				</listitem>
