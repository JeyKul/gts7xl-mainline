#!/system/bin/sh
# busybox udhcpc event script: address, default route and resolver
bb() { /linux-tools/lib/ld-musl-aarch64.so.1 --library-path /linux-tools/lib /linux-tools/bin/busybox "$@"; }
case "$1" in
deconfig) bb ip addr flush dev "$interface" ;;
bound|renew)
	bb ip addr flush dev "$interface"
	bb ip addr add "$ip/${mask:-24}" dev "$interface"
	for r in $router; do bb ip route replace default via "$r" dev "$interface"; break; done
	: > /etc/resolv.conf
	for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
	;;
esac
exit 0
