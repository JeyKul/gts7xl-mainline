#!/system/bin/sh
# Doom from the Linux install (doomretro + Freedoom in a home folder), on the GPU.
# The menu entry checks and asks init to start the gts7xl-doom service ("run"),
# which stops TWRP's UI for the screen and starts it again when Doom quits. It
# has to be a service of its own: stopping recovery kills everything TWRP started.
grep -q " /linux " /proc/mounts || { echo "Open Linux data first"; exit 1; }
W=$(ls /linux/@home/*/freedoom2.wad /linux/@home/*/freedoom1.wad 2>/dev/null | head -n1)
[ -n "$W" ] || { echo "No Freedoom WAD in a home folder"; exit 1; }
[ -x /linux/@/usr/bin/doomretro ] || { echo "doomretro is not installed in Linux"; exit 1; }
W=/${W#/linux/@}
if [ "$1" != run ]; then
	start gts7xl-doom
	exit 0
fi
stop recovery
sleep 1
linux-chroot env SDL_VIDEO_DRIVER=kmsdrm SDL_AUDIODRIVER=dummy HOME="${W%/*}" doomretro -iwad "$W" > /tmp/doom.log 2>&1
start recovery
