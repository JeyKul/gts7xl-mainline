# Mainline kernel only
on early-init
    # No ashmem since Linux 5.18: libcutils then needs to be told to use memfd,
    # or the UI's code cache aborts the recovery
    setprop sys.use_memfd true
    # Route the USB data lines to the SoC before adbd starts
    exec u:r:recovery:s0 root root -- /system/bin/usbroute

on post-fs
    # GPU firmware (firmware_class.path=/tmp/gts7xl-fw), CPU temperature for the UI
    exec u:r:recovery:s0 root root -- /system/bin/gts7xl-setup.sh

# The keyboard cover's touchpad as a mouse
service gts7xl-pad2mouse /system/bin/gts7xl-pad2mouse
    user root
    group root input
    seclabel u:r:recovery:s0
    disabled

# Recovery init never starts class core
on boot
    start gts7xl-pad2mouse

# Need QSEECOM, spcom and Samsung drivers that mainline doesn't have
service qseecomd /system/bin/true
    override
    disabled
service keymaster-4-0 /system/bin/true
    override
    disabled
service keymaster-sb-4-0 /system/bin/true
    override
    disabled
service gatekeeper-1-0-qti /system/bin/true
    override
    disabled
service spdaemon /system/bin/true
    override
    disabled
service sec_nvm /system/bin/true
    override
    disabled

# Android's shutdown sequence hangs on this kernel: reboot directly instead
on property:sys.powerctl=*
    exec u:r:recovery:s0 root root -- /system/bin/gts7xl-reboot.sh ${sys.powerctl}
