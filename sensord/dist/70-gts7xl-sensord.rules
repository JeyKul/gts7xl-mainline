# iio-sensor-proxy's input-accel driver takes this device.
# Measured: landscape with the camera on top reads +g on the sensor X axis.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gts7xl-sensord accelerometer", ENV{ID_INPUT_ACCELEROMETER}="1", ENV{ACCEL_MOUNT_MATRIX}="0, 1, 0; -1, 0, 0; 0, 0, 1"
