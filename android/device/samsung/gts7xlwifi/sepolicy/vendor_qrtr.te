# Qualcomm IPC router helpers (qrtr-ns, pd-mapper, tqftpserv). SELinux is
# permissive while the port comes up; these get proper rules later.
type vendor_qrtr, domain;
type vendor_qrtr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_qrtr)
permissive vendor_qrtr;

# Sets hci0's address from efs (read only), then exits
type vendor_gts7xl_btaddr, domain;
type vendor_gts7xl_btaddr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_gts7xl_btaddr)
permissive vendor_gts7xl_btaddr;

# Starts the DSPs and sets the speaker route, then exits
type vendor_gts7xl_dsp_up, domain;
type vendor_gts7xl_dsp_up_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_gts7xl_dsp_up)
permissive vendor_gts7xl_dsp_up;

# Serves the sensor DSP its files (gts7xl-sensord)
type vendor_gts7xl_sensord, domain;
type vendor_gts7xl_sensord_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_gts7xl_sensord)
permissive vendor_gts7xl_sensord;
