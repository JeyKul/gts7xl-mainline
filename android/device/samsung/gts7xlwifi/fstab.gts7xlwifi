# <src>                                    <mnt point>          <type> <mnt flags>                                                     <fs_mgr flags>
system                                     /system              erofs  ro                                                              wait,logical,first_stage_mount
system_ext                                 /system_ext          erofs  ro                                                              wait,logical,first_stage_mount
product                                    /product             erofs  ro                                                              wait,logical,first_stage_mount
vendor                                     /vendor              erofs  ro                                                              wait,logical,first_stage_mount
vendor_dlkm                                /vendor_dlkm         erofs  ro                                                              wait,logical,first_stage_mount
/dev/block/by-name/metadata                /metadata            ext4   noatime,nosuid,nodev,discard                                    wait,formattable,first_stage_mount,check
# Unencrypted while the port comes up (FBE's directory policies failed in
# post-fs-data); later: fileencryption=aes-256-xts:aes-256-cts:v2 with inlinecrypt
/dev/block/by-name/userdata                /data                f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,quota,reservedsize=128M
/dev/block/by-name/cache                   /cache               ext4   noatime,nosuid,nodev                                            wait,formattable,check
# The tablet's own firmware partition, read only
/dev/block/by-name/apnhlos                 /vendor/etc/apnhlos vfat   ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:vendor_firmware_file:s0 wait
/devices/platform/soc@0/8804000.mmc/mmc_host* auto              auto   defaults                                                        voldmanaged=sdcard1:auto
/devices/platform/soc@0/a600000.usb*       auto                 auto   defaults                                                        voldmanaged=usb:auto
# Bootloader message (reboot recovery writes boot-recovery here)
/dev/block/by-name/misc                    /misc               emmc   defaults                                                        defaults
