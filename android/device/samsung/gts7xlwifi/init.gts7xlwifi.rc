import /vendor/etc/init/hw/init.gts7xlwifi.usb.rc

on early-init
    # Bring-up: every boot's kernel log and logcat on /metadata (mounted in the
    # first stage, ext4, which TWRP reads)
    mkdir /metadata/gts7xl 0775 root system
    start vendor.gts7xl-bootlog
    # The modules ueventd doesn't load by alias (vendor_dlkm's modules.load)
    exec u:r:vendor_modprobe:s0 -- /system/bin/modprobe -a -d /vendor/lib/modules hci_uart rtc-pm8xxx qcom-spmi-adc5 uinput

on init
    # Compressed swap
    write /sys/block/zram0/comp_algorithm lz4
    # efs, read only (bt_addr)
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/efs 0750 system bluetooth

on fs
    # Everything but /data (cache, the firmware partition)
    mount_all /vendor/etc/fstab.gts7xlwifi --early

# /metadata is only 27 MB (apexd and encryption need it): the kernel log only, capped
service vendor.gts7xl-bootlog /vendor/bin/sh -c "/system/bin/dmesg -w 2>&1 | /system/bin/head -c 4194304 > /metadata/gts7xl/kmsg.txt"
    user root
    group root log
    seclabel u:r:su:s0
    disabled
    oneshot

# logcat once logd is up; it waits for logd on its own and is restarted if not
# logcat on /data, rotated (2 x 8 MB)
service vendor.gts7xl-logcat /system/bin/logcat -b all -v time -f /data/vendor/gts7xl-log/logcat.txt -r 8192 -n 2
    user root
    group root log
    seclabel u:r:su:s0
    disabled

on property:logd.ready=true && property:sys.boot_completed=1
    mkdir /data/vendor/gts7xl-log 0750 root log
    start vendor.gts7xl-logcat

on post-fs
    # efs by hand, not in the fstab: fs_mgr would replay its journal and run
    # e2fsck on it. noload: nothing is ever written
    mount ext4 /dev/block/by-name/efs /mnt/vendor/efs ro nosuid nodev noatime noload
    start vendor.gts7xl-btaddr
    start vendor.gts7xl-dsp-up

# ADSP/SLPI/CDSP start and the speaker mixer route
service vendor.gts7xl-dsp-up /vendor/bin/gts7xl-dsp-up.sh
    stdio_to_kmsg
    user root
    group audio
    disabled
    oneshot

# Bluetooth address from efs: without it hci0 stays unconfigured
service vendor.gts7xl-btaddr /vendor/bin/gts7xl-btaddr
    stdio_to_kmsg
    user root
    group bluetooth
    disabled
    oneshot

on late-fs
    # /data (latemount)
    mount_all /vendor/etc/fstab.gts7xlwifi --late

on post-fs-data
    mkdir /data/vendor/gts7xl-sensord 0700 root root
    mkdir /mnt/vendor/persist-ro 0700 root root
    start vendor.gts7xl-sensord
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # The panel's backlight, for the framework's brightness control
    chown system system /sys/class/backlight/ae94000.dsi.0/brightness
    chmod 0664 /sys/class/backlight/ae94000.dsi.0/brightness

# Remote processors find their services through these
service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    class core
    user root
    group system
service vendor.pd-mapper /vendor/bin/pd-mapper
    class core
    user root
    group system
service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    user wifi
    group system wifi inet keystore
    capabilities NET_ADMIN NET_RAW
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# File server for the sensor DSP (registry, configs), see gts7xl-sensors-setup.sh
service vendor.gts7xl-sensord /vendor/bin/gts7xl-sensors-setup.sh
    user root
    group system
    stdio_to_kmsg
    disabled
