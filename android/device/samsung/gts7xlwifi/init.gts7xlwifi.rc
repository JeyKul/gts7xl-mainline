import /vendor/etc/init/hw/init.gts7xlwifi.usb.rc

on early-init
    # The modules ueventd doesn't load by alias (vendor_dlkm's modules.load)
    exec u:r:vendor_modprobe:s0 -- /system/bin/modprobe -a -d /vendor/lib/modules hci_uart rtc-pm8xxx qcom-spmi-adc5 uinput

on init
    # Compressed swap
    write /sys/block/zram0/comp_algorithm lz4

on fs
    mount_all /vendor/etc/fstab.gts7xlwifi --late

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # The panel's backlight, for the framework's brightness control
    chown system system /sys/class/backlight/ae94000.dsi.0/brightness
    chmod 0664 /sys/class/backlight/ae94000.dsi.0/brightness

# Remote processors find their services through these
service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    class core
    user root
    group system
service vendor.pd-mapper /vendor/bin/pd-mapper
    class core
    user root
    group system
service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
