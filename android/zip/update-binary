#!/sbin/sh
# Installs AOSP for the Galaxy Tab S7+ Wi-Fi (SM-T970) from TWRP.
# Writes boot and super, blanks dtbo's header, clears param's recovery flag.
# Data is never touched: wipe it yourself in TWRP on a first install.
OUTFD=$2
ZIP=$3
B=/dev/block/bootdevice/by-name
[ -e $B/super ] || B=/dev/block/by-name

# TWRP's mksh can't redirect to fd numbers above 9
ui() { printf 'ui_print %s\nui_print\n' "$*" > /proc/self/fd/$OUTFD; }
die() { ui "ERROR: $*"; ui "Nothing after this step was written."; exit 1; }
sum() { sha256sum | cut -c1-64; }
want() { grep "  $1\$" /tmp/gts7xl-aosp/sha256 | cut -c1-64; }

ui "AOSP 17 for the Galaxy Tab S7+ Wi-Fi (mainline kernel)"

# The right tablet: only the Wi-Fi model (gts7xlwifi, SM-T970)
ok=
for p in ro.product.device ro.build.product ro.product.vendor.device ro.boot.em.model ro.boot.bootloader; do
	case "$(getprop $p)" in gts7xlwifi|SM-T970*|T970*) ok=1;; esac
done
[ -n "$ok" ] || die "this is not a Galaxy Tab S7+ Wi-Fi (SM-T970)"

rm -rf /tmp/gts7xl-aosp; mkdir -p /tmp/gts7xl-aosp
unzip -p "$ZIP" sha256 > /tmp/gts7xl-aosp/sha256 || die "zip unreadable"
SUPER_SIZE=$(unzip -p "$ZIP" super-size)
[ -n "$SUPER_SIZE" ] || die "zip incomplete"

# Nothing may use the old system partitions while super is rewritten
for m in /system_root /system /system_ext /product /vendor /odm /vendor_dlkm; do umount $m 2>/dev/null; done

ui "Writing boot"
S=$(blockdev --getsize64 $B/boot)
dd if=/dev/zero of=$B/boot bs=1048576 count=$((S / 1048576)) 2>/dev/null
unzip -p "$ZIP" boot.img | dd of=$B/boot bs=1048576 2>/dev/null
N=$(unzip -p "$ZIP" boot.img | wc -c)
[ "$(head -c $N $B/boot | sum)" = "$(want boot.img)" ] || die "boot did not verify"

ui "Writing super (system, vendor, product), takes a few minutes"
unzip -p "$ZIP" super.raw | dd of=$B/super bs=1048576 2>/dev/null
sync
[ "$(head -c $SUPER_SIZE $B/super | sum)" = "$(want super.raw)" ] || die "super did not verify"

# The bootloader applies dtbo's overlays to the DTB in boot: blank its header
if [ "$(od -An -tx1 -N4 $B/dtbo | tr -d ' \n')" = d7b7ab1e ]; then
	ui "Blanking the dtbo header"
	dd if=/dev/zero of=$B/dtbo bs=4096 count=1 2>/dev/null
fi

# Entering TWRP with the keys sets byte 0 of param: the next boot would be TWRP again
dd if=/dev/zero of=$B/param bs=1 count=1 conv=notrunc 2>/dev/null

sync
# TWRP still maps the old partitions, and read only: map the new ones writable,
# so a GApps zip can be flashed right after this one
if command -v lptools >/dev/null; then
	for p in system system_ext product vendor vendor_dlkm; do
		lptools unmap $p >/dev/null 2>&1; lptools map $p >/dev/null 2>&1
	done
	ui "Done. GApps can be flashed now."
else
	ui "Done. For GApps: Reboot > Recovery first."
fi
ui "First boot takes a few minutes."
exit 0
