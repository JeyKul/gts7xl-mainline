# Tab S7+ Android: cmdline built in (the bootloader's is Samsung's), one DRM card
CONFIG_CMDLINE="console=null arm-smmu.disable_bypass=0 panic=30 fw_devlink.sync_state=timeout firmware_class.path=/vendor/firmware androidboot.hardware=gts7xlwifi androidboot.boot_devices=soc@0/1d84000.ufshc androidboot.selinux=permissive androidboot.verifiedbootstate=orange androidboot.usbcontroller=a600000.usb androidboot.init_fatal_reboot_target=recovery printk.devkmsg=on msm.r8q_zap_dyn=1 msm.r8q_zap_secvid=0 deferred_probe_timeout=30"
CONFIG_CMDLINE_FORCE=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_VERITY=y
CONFIG_DM_VERITY=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_FUSE_FS=y
CONFIG_INPUT_UINPUT=y
CONFIG_ZRAM=y
CONFIG_TIMED_VIBRATOR=n
CONFIG_INPUT_REGULATOR_HAPTIC=y
CONFIG_INCREMENTAL_FS=y
# Android mounts cpuset and memcg as cgroup v1 (/dev/cpuset, /dev/memcg); since
# 6.11 those interfaces need their own options
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
# Socket-family modules (QRTR) load through the kernel's modprobe helper, which
# Android has none of: built in, with what needs them early
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y
CONFIG_QRTR_TUN=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_MHI_BUS=y
